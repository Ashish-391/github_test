	column Sorting = IF(BW_Goal8_40[Year]=MAX(BW_Goal8_40[Year]),(MAX(BW_Goal8_40[Year])&BW_Goal8_40[Value]),BLANK())
		dataType: double
		lineageTag: e21675a8-6cd8-402c-8ccf-b5df6db5df38
