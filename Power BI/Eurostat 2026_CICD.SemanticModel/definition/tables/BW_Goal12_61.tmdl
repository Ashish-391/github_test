	partition BW_Goal12_61 = calculated
		mode: import
		source =
				
				
				var indicator = "SDG_12_61"
				var unit = "PC_GDP"
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator,'All_SDG_Goal5-12'[Geo]="EU27_2020",'All_SDG_Goal5-12'[Unit] = unit)
				
				RETURN
				
				    SELECTCOLUMNS (
				
				        FILTER
				
				('All_SDG_Goal5-12',('All_SDG_Goal5-12'[Time_Period]= maxTime_Period
				
				||
				
				'All_SDG_Goal5-12'[Time_Period]=maxTime_Period-5
				
				) && 'All_SDG_Goal5-12'[Indicator]=indicator &&'All_SDG_Goal5-12'[Unit] = unit),
				
				        "Year", 'All_SDG_Goal5-12'[Time_Period],
				
				        "Value", 'All_SDG_Goal5-12'[OBS_VALUE],
				
				        "Geo", 'All_SDG_Goal5-12'[Geo]
				
				    )

	annotation PBI_Id = e92a2c76edc74be0989e36bf786e06ff

