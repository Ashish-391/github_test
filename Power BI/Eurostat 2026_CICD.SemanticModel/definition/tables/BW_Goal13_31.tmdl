	column Sorting = IF(BW_Goal13_31[Year]=MAX(BW_Goal13_31[Year]),(MAX(BW_Goal13_31[Year])&BW_Goal13_31[Value]),BLANK())
		dataType: double
		lineageTag: 248fb7c8-48a3-474b-a0e7-1e4ad17e1435
