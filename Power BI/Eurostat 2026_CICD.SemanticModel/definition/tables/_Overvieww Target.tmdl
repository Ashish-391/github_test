	measure Long_BeginnningValue1 = ```
			
			// var Max_Year = MAX(Goal1_Overview[TIME_PERIOD])
			var Max_Year = [MaxxYear_Overview]
			var min_year = MIN(_Goal1_Overview[TIME_PERIOD])
			var longtermCalc = 
			                IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 15 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-15,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 14 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-14,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 13 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-13,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 12 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-12,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 11 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-11,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 10 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-10,BLANK()
			     )))))
			     
			     )
			
			return 
			IF(ISBLANK(longtermCalc), BLANK(),CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=longtermCalc))
