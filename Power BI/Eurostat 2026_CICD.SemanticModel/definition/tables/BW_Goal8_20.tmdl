	column Sorting = IF(BW_Goal8_20[Year]=MAX(BW_Goal8_20[Year]),(MAX(BW_Goal8_20[Year])&BW_Goal8_20[Value]),BLANK())
		dataType: double
		lineageTag: 75e24cd8-3d7f-44a7-b15f-5367ce34ba4e
