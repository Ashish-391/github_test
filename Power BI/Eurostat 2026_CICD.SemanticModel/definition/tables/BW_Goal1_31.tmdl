	column TIME_PERIOD
		formatString: 0
		lineageTag: cb48bc85-2d71-4287-9f54-a072d7f9d188
		summarizeBy: sum
		isNameInferred
		sourceColumn: [TIME_PERIOD]

		annotation SummarizationSetBy = Automatic

	partition BW_Goal1_31 = calculated
		mode: import
		source =
				
				VAR indicator = "SDG_01_31"
				VAR maxYear = CALCULATE(MAX(All_SDG_Goal1[TIME_PERIOD]), All_SDG_Goal1[Indicator] = indicator, All_SDG_Goal1[Geo] = "EU27_2020", All_SDG_Goal1[Unit] = "PC")
				RETURN
				    SELECTCOLUMNS (
				        FILTER (
				            All_SDG_Goal1,
				            (All_SDG_Goal1[TIME_PERIOD] = maxYear || All_SDG_Goal1[TIME_PERIOD] = maxYear - 5) && All_SDG_Goal1[Indicator] = indicator && All_SDG_Goal1[Unit] = "PC" )
				        ,
				        "TIME_PERIOD", All_SDG_Goal1[TIME_PERIOD],
				        "Value", All_SDG_Goal1[OBS_VALUE],
				        "CountryAbrv", All_SDG_Goal1[Geo]
				    )

	annotation PBI_Id = 4da6358423c349bdbfdc9bbfc4b41165

