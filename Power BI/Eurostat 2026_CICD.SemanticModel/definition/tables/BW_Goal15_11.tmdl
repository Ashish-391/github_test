	partition BW_Goal15_11 = calculated
		mode: import
		source =
				
				
				var indicator = "SDG_15_11"
				var unit = "PC"
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal15'[Time_Period]),'All_SDG_Goal15'[Indicator]=indicator,'All_SDG_Goal15'[Geo]="EU27_2020", 'All_SDG_Goal15'[Unit] = unit)
				
				RETURN
				
				    SELECTCOLUMNS (
				
				        FILTER
				
				('All_SDG_Goal15',('All_SDG_Goal15'[Time_Period]= maxTime_Period
				
				||
				
				'All_SDG_Goal15'[Time_Period]=maxTime_Period-3
				
				) && 'All_SDG_Goal15'[Indicator]=indicator && 'All_SDG_Goal15'[Unit] = unit),
				
				        "Year", 'All_SDG_Goal15'[Time_Period],
				
				        "Value", 'All_SDG_Goal15'[OBS_VALUE],
				
				        "Geo", 'All_SDG_Goal15'[Geo]
				
				    )

