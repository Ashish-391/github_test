table Goal1
	lineageTag: 28d9ef83-0219-4288-9fc7-cde9b288dfda

	measure obs_value_Goal1 =
			var unit = SELECTEDVALUE(Goal1[Unit])
			var age = SELECTEDVALUE(Goal1[age])
			VAR minDate =
			    CALCULATE (
			        MIN ( 'Goal1'[UpdatedFromDate] ),
			        ALLSELECTED ( 'Goal1'[UpdatedFromDate] ),Goal1[Unit]=unit,Goal1[age] =age
			    )
			VAR maxDate =
			    CALCULATE (
			        MAX ( 'Goal1'[UpdatedFromDate] ),
			        ALLSELECTED ( 'Goal1'[UpdatedFromDate] ),Goal1[Unit]=unit,Goal1[age] =age
			    )
			VAR dateCheck =
			    IF (
			        maxDate
			            IN ALLSELECTED ( 'Goal1'[UpdatedFromDate] ),
			        1,
			        0
			    ) //var datafilter = IF(dateCheck=0,CALCULATETABLE('Goal 1',FILTER('Goal 1','Goal 1'[UpdatedFromDate]<=maxDate)))
			RETURN
			    SWITCH (
			        TRUE (),
			        minDate <> maxDate,
			            CALCULATE (
			                MAX ( 'Goal1'[Value] ),
			                /* 'Goal 1'[UpdatedDate]>minDate && */
			                'Goal1'[UpdatedFromDate] = maxDate,Goal1[Unit]=unit,Goal1[age] =age
			            ),
			        minDate = maxDate,
			            CALCULATE (
			                MAX ( 'Goal1'[Value] ),
			                'Goal1'[UpdatedFromDate] = maxDate,Goal1[Unit]=unit,Goal1[age] =age
			            )
			    )
		lineageTag: 211a9bc9-0044-4d43-ad72-094609535f44

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Tooltip_obs_Goal1 =
			
			VAR minDate =
			    CALCULATE (
			        MIN ( 'Goal1'[UpdatedFromDate] ),
			        ALLSELECTED ( 'Goal1'[UpdatedFromDate] )
			    )
			VAR maxDate =
			    CALCULATE (
			        MAX ( 'Goal1'[UpdatedFromDate] ),
			        ALLSELECTED ( 'Goal1'[UpdatedFromDate] )
			    )
			VAR minValue =
			    CALCULATE (
			        MAX ( 'Goal1'[Value] ),
			        'Goal1'[UpdatedFromDate] = minDate
			    )
			VAR maxValue =
			    CALCULATE (
			        MAX ( 'Goal1'[Value] ),
			        'Goal1'[UpdatedFromDate] = maxDate
			    )
			VAR countRowsTotal =
			    COUNTROWS (
			        FILTER (
			            'Goal1',
			            'Goal1'[UpdatedFromDate] >= minDate
			                && 'Goal1'[UpdatedFromDate] <= maxDate
			        )
			    )
			RETURN
			    IF (
			        countRowsTotal >= 2,
			        IF (
			            minValue = maxValue,0,
			
			            1
			        ),0
			    )
		lineageTag: cd558186-038d-4919-a0f9-b6c9a0667d42

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure mindate =
			/* SELECTEDVALUE('Goal 1'[UpdatedFromDate]) */
			CALCULATE (
			    MIN ( 'Goal1'[UpdatedFromDate] ),
			    ALLSELECTED ( 'Goal1'[UpdatedFromDate] )
			)
			/* var minDate = CALCULATE(Min('Goal 1'[UpdatedFromDate]),ALLSELECTED('Goal 1'[UpdatedFromDate]))
			return
			CALCULATE(MAX('Goal 1'[Value]),'Goal 1'[UpdatedFromDate]=minDate) */
		formatString: General Date
		lineageTag: e2ea545a-a67a-4c1b-aca4-bade12969767

	measure maxdate =
			CALCULATE (
			    MAX ( 'Goal1'[UpdatedFromDate] ),
			    ALLSELECTED ( 'Goal1'[UpdatedFromDate] )
			) + 7
		formatString: dd mmmm yyyy
		lineageTag: 83e1f1a3-0bc3-42fa-8c61-5d90b195520a

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure CreatedDate = SELECTEDVALUE ( 'Goal1'[Created] )
		formatString: General Date
		lineageTag: e720e216-5546-4d34-847b-f427672abac7

	measure datess =
			VAR a =
			    MAX ( 'Goal1'[UpdatedFromDate] )
			VAR b = a - 14
			RETURN
			    IF (
			        b = b,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 037cb348-0e91-484c-a406-e7b3160f8a0b

	measure dateFilter =
			VAR dvalues =
			    VALUES ( 'Goal1'[UpdatedFromDate] )
			RETURN
			    IF (
			        dvalues,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 71a8d938-0f65-465a-b4e3-f00c4433d6f4

