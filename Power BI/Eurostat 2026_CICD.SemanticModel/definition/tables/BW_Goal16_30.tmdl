	column Sorting =
			
			var indicator = "SDG_16_30"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[TIME_PERIOD]),'All_SDG_Goal5-12'[Indicator]=indicator)
			RETURN
			IF(BW_Goal16_30[Year]=maxTime_Period,maxTime_Period&BW_Goal16_30[Value],BLANK())
		dataType: double
		lineageTag: cf08216c-8aa2-4044-b768-513d5893f725
