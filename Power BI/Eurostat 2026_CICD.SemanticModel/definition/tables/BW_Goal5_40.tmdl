table BW_Goal5_40
	lineageTag: 1110ae7f-c62f-4bfa-9a43-8a0ab6b6fbb7

	column Year
		formatString: 0
		lineageTag: 5d3b7e22-ef5c-4898-ab84-cd7aa96cd227
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Value
		lineageTag: e1e8ebad-130d-4b51-8442-162f7cc3013f
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

