	column DateColumn =
			var minDate = MIN('Goal1'[UpdatedFromDate])
			var maxDate = MAX('Goal1'[UpdatedFromDate])
			RETURN
			SWITCH(TRUE(),'Goal1'[UpdatedFromDate]<minDate,BLANK(),'Goal1'[UpdatedFromDate]>maxDate,BLANK(), 'Goal1'[UpdatedFromDate])
		formatString: dd mmmm yyyy
		lineageTag: 23276dc3-a256-48ae-a3cc-64f747437af6
		summarizeBy: none

