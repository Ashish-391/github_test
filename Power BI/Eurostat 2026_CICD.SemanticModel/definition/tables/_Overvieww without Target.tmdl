	measure CAGR_ShortTerm_WT = ```
			
			/* var Max_Year1 = CALCULATE(MAX(Goal1_Overview[TIME_PERIOD])) 
			var min_year2 = CALCULATE(MIN(Goal1_Overview[TIME_PERIOD]))
			var longterm = Max_Year1 - min_year2
			VAR max_year = MAX(Goal1_Overview[TIME_PERIOD])
			Var Short  = IF(longterm =16, max_Year - 6,IF(longterm = 14, max_year - 6,max_year - 5))
			var S_year = max_year - Short */
			var a = SELECTEDVALUE(_Goal1_Overview[Indicator])
			var S_year = [MaxxYear_Overview] - [MaxYearMinus3or5_Overvieww]
			Var numerator = IF(a="SDG_06_60", [Moving Avg],IF(a= "SDG_14_60",[Moving Avg_14_60],IF(a="SDG_15_42" || a="SDG_15_42*",[Moving Avg_15_42], [Ending Value WT])))
			Var Denominator = IF(a="SDG_06_60",[Shorterm Moving Avg],IF(a= "SDG_14_60",[Shorterm Moving Avg_14_60],IF(a="SDG_15_42" || a="SDG_15_42*",[Shorterm Moving Avg_15_42], [ShortTermBeginningValue_WT])))
			return  
			
			IF(ISBLANK([ShortTermBeginningValue_WT]),BLANK() , ROUND(((DIVIDE(numerator,Denominator)^(1/S_year)-1)  ) * 100,4))
			```
