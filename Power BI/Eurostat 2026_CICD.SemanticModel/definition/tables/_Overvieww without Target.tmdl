	measure CAGR_LongTerm_WT = ```
			
			var Max_Year = CALCULATE(MAX(_Goal1_Overview[TIME_PERIOD])) 
			var min_year = CALCULATE(MIN(_Goal1_Overview[TIME_PERIOD]))
			var a = SELECTEDVALUE(_Goal1_Overview[Indicator])
			var longtermYear = 
			     /* IF( MAX(_Goal1_Overview[Indicator]) = "SDG_15_50*",
			     Max_Year-13,
			     IF( MAX(_Goal1_Overview[Indicator]) = "SDG_15_50",
			     Max_Year-13, */
			IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 15 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-15,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 14 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-14,
			        IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 13 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-13,
			            IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 12 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-12,
			                IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 11 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-11,
			                    IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 10 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-10, BLANK()
			
			     
			                        )
			                    )
			                )
			            )
			        )
			     
			     )
			
			
			var longexpo =IF( MAX(_Goal1_Overview[Indicator]) = "SDG_12_51",
			     14,
			/*  IF( MAX(_Goal1_Overview[Indicator]) = "SDG_15_50*",
			     13,
			     IF( MAX(_Goal1_Overview[Indicator]) = "SDG_15_50",
			     13, */
			/*  IF( MAX(_Goal1_Overview[Indicator]) = "SDG_15_42"||MAX(_Goal1_Overview[Indicator]) = "SDG_15_42*" ,
			     11,  */   
			IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 15 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     15,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 14 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     14,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 13 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     13,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 12 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     12,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 11 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     11,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 10 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     10, BLANK()
			     )))))))
			
			
			
			var expo = 1/longexpo
			Var numerator = IF(a="SDG_06_60", [Moving Avg],IF(a="SDG_14_60",[Moving Avg_14_60],IF(a="SDG_15_42"|| a = "SDG_15_42*" ,[Moving Avg_15_42], ([Ending Value WT]))))
			Var Denominator = IF(a="SDG_06_60",[Longterm Moving Avg],IF(a="SDG_14_60",[Longterm Moving Avg_14_60],IF(a="SDG_15_42"
			 ||a="SDG_15_42*",[Longterm Moving Avg_15_42], [Long_BeginnningValue WT])))
			
			return
			IF(ISBLANK(longtermYear),BLANK(),ROUND( (((numerator/Denominator)^(expo)) - 1 ) * 100,3))
			```
