table BW_Goal6_50
	lineageTag: 95095dbf-0b9c-4a04-861b-498a69e91d8c

	column Year
		formatString: 0
		lineageTag: 29a950eb-3653-4ff7-853e-4715f754f153
		summarizeBy: sum
