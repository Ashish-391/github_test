	column Sorting =
			
			var indicator = "SDG_04_31"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal4'[Time_Period]),'All_SDG_Goal4'[Indicator]=indicator)
			RETURN
			IF(BW_Goal4_31[Year]=maxTime_Period,maxTime_Period&BW_Goal4_31[Value],BLANK())
		dataType: double
