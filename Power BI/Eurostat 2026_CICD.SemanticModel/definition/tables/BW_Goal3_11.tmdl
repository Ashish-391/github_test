	partition BW_Goal3_11 = calculated
		mode: import
		source =
				
				var indicator = "SDG_03_11"
				//Var maxDate = CALCULATE(MAX(All_SDG_Goal3[UpdatedFromDate]),All_SDG_Goal3[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX(All_SDG_Goal3[Time_Period]),All_SDG_Goal3[Indicator]=indicator,All_SDG_Goal3[Geo]="EU27_2020")
				RETURN
				FILTER
				(All_SDG_Goal3,(All_SDG_Goal3[Time_Period]= maxTime_Period
				||
				All_SDG_Goal3[Time_Period]=maxTime_Period-5
				) && All_SDG_Goal3[Indicator]=indicator )

	annotation PBI_Id = ed2bfbcb86c6462a90805d19115b6c19

