	column Sorting =
			
			var indicator = "SDG_04_60"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal4'[Time_Period]),'All_SDG_Goal4'[Indicator]=indicator)
			RETURN
			IF(BW_Goal4_60[Year]=maxTime_Period,maxTime_Period&BW_Goal4_60[Value],BLANK())
		dataType: double
		lineageTag: c364b3c8-fa21-409a-bf4a-ddcbc57acf25
		summarizeBy: sum

