table BW_Goal5_50
	lineageTag: 7ef38541-ab7f-4674-a94d-24407f39d3ba

	column Year
		formatString: 0
		lineageTag: d2f34de2-8048-49bb-bff4-a9e9c4e558d7
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

