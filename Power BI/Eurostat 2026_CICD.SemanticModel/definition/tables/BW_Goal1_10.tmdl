	partition BW_Goal1_10 = calculated
		mode: import
		source = ```
				
				-------------------------------------------------------------------------------------------
				
				var maxYear = CALCULATE(MAX(All_SDG_Goal1[TIME_PERIOD]),All_SDG_Goal1[Geo]="EU27_2020",All_SDG_Goal1[Indicator] = "SDG_01_10", All_SDG_Goal1[Age] = "TOTAL", All_SDG_Goal1[Unit] = "PC")
				RETURN
				    SELECTCOLUMNS (
				        FILTER
				(All_SDG_Goal1,(All_SDG_Goal1[TIME_PERIOD]= maxYear
				||
				All_SDG_Goal1[TIME_PERIOD]=maxYear-5
				) && All_SDG_Goal1[Indicator] = "SDG_01_10" && All_SDG_Goal1[Age] = "TOTAL" && All_SDG_Goal1[Unit] = "PC" ),
				        "Year", All_SDG_Goal1[TIME_PERIOD],
				        "Value",All_SDG_Goal1[OBS_VALUE],
				        "Geo", All_SDG_Goal1[Geo]
				    )
				
