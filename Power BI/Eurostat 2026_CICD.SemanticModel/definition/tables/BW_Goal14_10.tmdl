	column Sorting =
			
			var indicator = "SDG_14_10"
			var maxTime_Period = CALCULATE(MAX(All_SDG_Goal12[TIME_PERIOD]),All_SDG_Goal12[Indicator]=indicator)
			RETURN
			IF(BW_Goal14_10[Year]=maxTime_Period,maxTime_Period&BW_Goal14_10[Value],BLANK())
