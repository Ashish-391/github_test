	measure 'Long Term Moving Avgg' = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			VAR Max_Year = CALCULATE(MAX(Goal1[Year]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[CountryAbrv]=countrySelect,Goal1[IndicatorValue]=indicator)
			var Max_Year15_42 = CALCULATE(MAX(Goal1[Year]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[CountryAbrv]="EU27_2020",Goal1[IndicatorValue]="SDG_15_42")
			var min_year = CALCULATE(MIN(Goal1[Year]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[IndicatorValue]=indicator,Goal1[CountryAbrv]=countrySelect)
			var CURRENT_YEAR = 
			IF(indicator="SDG_15_50",Max_Year-16,
			IF(indicator="SDG_15_42",Max_Year15_42-14,
			 IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 15 && NOT ISBLANK(Goal1[Value]) && Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-15,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 14 && NOT ISBLANK(Goal1[value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-14,
			        IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 13 && NOT ISBLANK(Goal1[value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-13,
			            IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 12 && NOT ISBLANK(Goal1[value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-12,
			                IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 11 && NOT ISBLANK(Goal1[value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-11,
			                    IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 10 && NOT ISBLANK(Goal1[value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-10,
			     BLANK()
			                        )
			                    )
			                )
			            )
			        )
			     
			     )
			))
			
			RETURN
			IF(indicator="SDG_15_42",AVERAGEX(FILTER(Goal1,(Goal1[Year]>=CURRENT_YEAR-9 && Goal1[Year]<=CURRENT_YEAR) && (ALLSELECTED(Goal1[UpdatedFromDate]) && Goal1[IndicatorValue]=indicator&& Goal1[CountryAbrv]=countrySelect)),Goal1[Value]),
			if( indicator = "SDG_14_60",AVERAGEX(FILTER(Goal1,(Goal1[Year]>=CURRENT_YEAR-3 && Goal1[Year]<=CURRENT_YEAR) && (ALLSELECTED(Goal1[UpdatedFromDate]) && Goal1[IndicatorValue]="SDG_14_60" && Goal1[CountryAbrv]=country)),Goal1[Value]), if(indicator <> "SDG_14_60",
			AVERAGEX(FILTER(Goal1,(Goal1[Year]>=CURRENT_YEAR-3 && Goal1[Year]<=CURRENT_YEAR) && (ALLSELECTED(Goal1[UpdatedFromDate]) && Goal1[IndicatorValue]=indicator && Goal1[CountryAbrv]=countrySelect)),Goal1[Value]))))
