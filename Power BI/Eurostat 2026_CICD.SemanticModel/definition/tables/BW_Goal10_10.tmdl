	column 'Index EU 100' =
			
			var indicator = "SDG_10_10"
			var unit = CALCULATE(MAX('All_SDG_Goal5-12'[Unit]),'All_SDG_Goal5-12'[Indicator]=indicator)
			RETURN
			IF(unit="PC",100)
		formatString: 0
		lineageTag: e317e92d-d6fe-4ebe-89bf-619434190213
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition BW_Goal10_10 = calculated
		mode: import
		source =
				
				var indicator = "SDG_10_10"
				
				//Var maxDate = CALCULATE(MAX('Goal 4 BW'[UpdatedFromDate]),'Goal 4 BW'[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator,'All_SDG_Goal5-12'[Geo]="EU27_2020",'All_SDG_Goal5-12'[indic_ppp]="VI_PPS_EU27_2020_HAB")
				RETURN
				    SELECTCOLUMNS (
				        FILTER
				('All_SDG_Goal5-12',('All_SDG_Goal5-12'[Time_Period]= maxTime_Period)
				 && 'All_SDG_Goal5-12'[Indicator]=indicator && 'All_SDG_Goal5-12'[indic_ppp]="VI_PPS_EU27_2020_HAB"),
				        "Year", 'All_SDG_Goal5-12'[Time_Period],
				        "Value", 'All_SDG_Goal5-12'[OBS_VALUE],
				        "Geo", 'All_SDG_Goal5-12'[Geo]
				    )

	annotation PBI_Id = 5767f65389c64e109e75247debb88b92

