	column Sorting = IF(BW_Goal16_20[Year]=MAX(BW_Goal16_20[Year]),(MAX(BW_Goal16_20[Year])&BW_Goal16_20[Value]),BLANK())
		dataType: double
		lineageTag: 1911f8c9-b411-4489-89ff-c09b58105e61
