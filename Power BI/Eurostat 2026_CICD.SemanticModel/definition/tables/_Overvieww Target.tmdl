	measure aero =
			
			Var yearlabel = SELECTEDVALUE('_Overvieww Target'[Year-Label])
			Var header = SELECTEDVALUE('_Overvieww Target'[CAGR-Header])
			return
			SWITCH(TRUE(),
			yearlabel="Short Term" && header= "Observed",(DIVIDE([CAGR_ShortTerm_T],[CAGR-TargetShorTermT]) * 100),
			yearlabel="Short Term" && header="Required",(DIVIDE([CAGR_ShortTerm_T],[CAGR-TargetShorTermT]) * 100),
			yearlabel="Long Term"&& header ="Required",IF( ISBLANK([CAGR-TargetLongTerm T]), 1,DIVIDE([Overvieww_CAGRLongTerm_Observed],[CAGR-TargetLongTerm T])*100),
			yearlabel="Long Term"&& header="Observed",IF( ISBLANK([CAGR-TargetLongTerm T]), 1,DIVIDE([Overvieww_CAGRLongTerm_Observed],[CAGR-TargetLongTerm T])*100),BLANK())
