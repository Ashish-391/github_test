	column Geo
		lineageTag: 33853ef5-07c5-43c4-bc87-092bfdff05bb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Geo]

		annotation SummarizationSetBy = Automatic

	column Sorting =
			
			var indicator = "SDG_16_40"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[TIME_PERIOD]),'All_SDG_Goal5-12'[Indicator]=indicator)
			RETURN
			IF(BW_Goal16_40[Year]=maxTime_Period,maxTime_Period&BW_Goal16_40[Value],BLANK())
		dataType: double
		lineageTag: ebadf2e9-bf01-49b1-9434-6d9a2992a01a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition BW_Goal16_40 = calculated
		mode: import
		source =
				
				
				var indicator = "SDG_16_40"
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator,'All_SDG_Goal5-12'[Geo]="EU27_2020")
				
				RETURN
				
				    SELECTCOLUMNS (
				
				        FILTER
				
				('All_SDG_Goal5-12',('All_SDG_Goal5-12'[Time_Period]= maxTime_Period
				
				||
				
				'All_SDG_Goal5-12'[Time_Period]=maxTime_Period-5
				
				) && 'All_SDG_Goal5-12'[Indicator]=indicator),
				
				        "Year", 'All_SDG_Goal5-12'[Time_Period],
				
				        "Value", 'All_SDG_Goal5-12'[OBS_VALUE],
				
				        "Geo", 'All_SDG_Goal5-12'[Geo]
				
				    )

	annotation PBI_Id = e1d54f53708c47d58b2da37cf8bbedc9

