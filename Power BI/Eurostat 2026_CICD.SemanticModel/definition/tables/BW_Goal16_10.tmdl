	column Sorting =
			
			var indicator = "SDG_16_10"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[TIME_PERIOD]),'All_SDG_Goal5-12'[Indicator]=indicator)
			RETURN
			IF(BW_Goal16_10[Year]=maxTime_Period,maxTime_Period&BW_Goal16_10[Value],BLANK())
		dataType: double
		lineageTag: 3c308890-b7b3-4e9a-b845-7fd3a959e4e4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition BW_Goal16_10 = calculated
		mode: import
		source =
				
				var indicator = "sdg_16_10"
				var sex = "T"
				//Var maxDate = CALCULATE(MAX('Goal 4 BW'[UpdatedFromDate]),'Goal 4 BW'[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator,'All_SDG_Goal5-12'[Geo]="EU27_2020", 'All_SDG_Goal5-12'[Sex] = sex)
				RETURN
				    SELECTCOLUMNS (
				        FILTER
				('All_SDG_Goal5-12',('All_SDG_Goal5-12'[Time_Period]= maxTime_Period
				||
				'All_SDG_Goal5-12'[Time_Period]=maxTime_Period-5
				) && 'All_SDG_Goal5-12'[Indicator]=indicator && 'All_SDG_Goal5-12'[Sex] = sex),
				        "Year", 'All_SDG_Goal5-12'[Time_Period],
				        "Value", 'All_SDG_Goal5-12'[OBS_VALUE],
				        "Geo", 'All_SDG_Goal5-12'[Geo]
				    )

	annotation PBI_Id = ae840bb949394b8ba5ea83a1bcdff821

