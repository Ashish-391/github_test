		lineageTag: bd78e33d-1731-4286-8582-e868737bd8e7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Geo]

		annotation SummarizationSetBy = Automatic

	column Sorting =
			
			var indicator = "SDG_02_53"
			//Var maxDate = CALCULATE(MAX(BW_Goal2_53[UpdatedFromDate]),BW_Goal2_53[IndicatorValue]=indicator)
			var maxTime_Period = CALCULATE(MAX(All_SDG_Goal_2[Time_Period]),All_SDG_Goal_2[Indicator]=indicator,All_SDG_Goal_2[Geo]="EU27_2020")
			RETURN
			IF(BW_Goal2_53[Year]=maxTime_Period,maxTime_Period&BW_Goal2_53[VALUE],BLANK())
		dataType: double
		lineageTag: 251d7329-3808-4a88-980d-c2cccfd3a4e4
		summarizeBy: sum

