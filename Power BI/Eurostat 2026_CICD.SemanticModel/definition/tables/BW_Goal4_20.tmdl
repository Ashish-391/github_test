		sourceColumn: [Geo]

		annotation SummarizationSetBy = Automatic

	column Sorting =
			
			var indicator = "SDG_04_20"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal4'[Time_Period]),'All_SDG_Goal4'[Indicator]=indicator)
			RETURN
			IF(BW_Goal4_20[Year]=maxTime_Period,maxTime_Period&BW_Goal4_20[Value],BLANK())
		dataType: double
		lineageTag: a4cb1c58-b444-47f6-ba4b-425646fc49d9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition BW_Goal4_20 = calculated
		mode: import
		source =
				
				var indicator = "SDG_04_20"
				//Var maxDate = CALCULATE(MAX('Goal 4 BW'[UpdatedFromDate]),'Goal 4 BW'[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal4'[Time_Period]),'All_SDG_Goal4'[Indicator]=indicator,'All_SDG_Goal4'[Geo]="EU27_2020")
				RETURN
				    SELECTCOLUMNS (
				        FILTER
				('All_SDG_Goal4',('All_SDG_Goal4'[Time_Period]= maxTime_Period
				||
				'All_SDG_Goal4'[Time_Period]=maxTime_Period-5
				) && 'All_SDG_Goal4'[Indicator]=indicator ),
				        "Year", All_SDG_Goal4[Time_Period],
				        "Value", All_SDG_Goal4[OBS_VALUE],
				        "Geo", All_SDG_Goal4[Geo]
				    )

	annotation PBI_Id = 7415bef88a2746f184823484a8da0143

