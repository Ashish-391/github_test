	column Sorting = IF(BW_Goal8_30[Year]=MAX(BW_Goal8_30[Year]),(MAX(BW_Goal8_30[Year])&BW_Goal8_30[Value]),BLANK())
		dataType: double
		lineageTag: b84b5f05-0687-4b53-ae8c-452db41cfde8
