	column Sorting = IF(BW_Goal10_41[Year]=MAX(BW_Goal10_41[Year]),(MAX(BW_Goal10_41[Year])&BW_Goal10_41[Value]),BLANK())
		dataType: double
		lineageTag: 4a2f2fe8-7ebb-4fcd-9c0d-902474f04b59
