table BW_Goal3_70
	lineageTag: b3df3889-0a5c-49de-b5ca-b32f73aebc68

	column Year
		formatString: 0
		lineageTag: b9abfafe-6002-4a0a-81f5-ce30675db21d
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

