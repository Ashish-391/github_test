	column Sorting = IF(BW_Goal9_40[Year]=MAX(BW_Goal9_40[Year]),(MAX(BW_Goal9_40[Year])&BW_Goal9_40[Value]),BLANK())
		dataType: double
		lineageTag: 3e7d8bf0-8d02-4bf6-8927-db92845d5268
