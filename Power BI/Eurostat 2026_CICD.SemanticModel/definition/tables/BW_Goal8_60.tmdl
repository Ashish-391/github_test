	column Sorting =
			
			var indicator = "SDG_08_60"
			var maxTime_Period = CALCULATE(MAX(BW_Goal8_60[TIME_PERIOD]))
			    /* 'All_SDG_Goal5-6-7'[Time_Period]),'All_SDG_Goal5-6-7'[Indicator]=indicator) */
			RETURN
			IF(BW_Goal8_60[TIME_PERIOD]=MAX(BW_Goal8_60[TIME_PERIOD]),(MAX(BW_Goal8_60[TIME_PERIOD])&BW_Goal8_60[OBS_VALUE]),BLANK())
