	measure 'Covid 19 Impact' =
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var covid19Value = CALCULATE(MAX(Goal1[Value]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[IndicatorValue]=indicator,Goal1[Year]=2019)
			var covid20Value = CALCULATE(MAX(Goal1[Value]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[IndicatorValue]=indicator,Goal1[Year]=2020)
			RETURN
			IF(covid19Value=BLANK() || covid20Value=BLANK(),"NA","2019-2020")
		lineageTag: ca614154-3873-48c5-bfaf-140974091651

	measure Pre-COVID-19 =
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var covid19Value = CALCULATE(MAX(Goal1[Value]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[IndicatorValue]=indicator,Goal1[Year]=2019)
			RETURN
			IF(covid19Value=BLANK(),"NA","2019-" & [1CY])
