	measure 'CAGR-TargetLongTerm T' = ```
			
			//var target = Max
			
			var Max_Year1 = MAX(_Goal1_Overview[TIME_PERIOD])
			var min_year2 = MIN(_Goal1_Overview[TIME_PERIOD])
			var longtermCalc = /* SWITCH(TRUE(),(Max_Year1 - min_year2)>=15,Max_Year1-15,(Max_Year1 - min_year2)<10,BLANK(),(Max_Year1 - min_year2)=14,Max_Year1-14,(Max_Year1 - min_year2)=13,Max_Year1-13,(Max_Year1 - min_year2)=12,Max_Year1-12,(Max_Year1 - min_year2)=11,Max_Year1-11,(Max_Year1 - min_year2)=10,Max_Year1-10,BLANK()) */
			IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year1 - 15 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year1-15,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year1 - 14 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year1-14,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year1 - 13 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year1-13,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year1 - 12 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year1-12,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year1 - 11 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year1-11,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year1 - 10 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year1-10,BLANK()
			     )))))
			     
			     )
			VAR Indi = SELECTEDVALUE(_Goal1_Overview[Indicator])
			
			var Max_Year = 2030
			var min_year = CALCULATE(MIN(_Goal1_Overview[TIME_PERIOD]))
			var longtermYear = SWITCH(TRUE(),(Max_Year - min_year)>=15,Max_Year-15,(Max_Year - min_year)<10,BLANK(),(Max_Year - min_year)=14,Max_Year-14,(Max_Year - min_year)=13,Max_Year-13,(Max_Year - min_year)=12,Max_Year-12,(Max_Year - min_year)=11,Max_Year-11,(Max_Year - min_year)=10,Max_Year-10,BLANK())
			
			var longexpo = IF(Indi = "sdg_05_60", 2026 - longtermCalc,Max_Year - longtermCalc)
			/* SWITCH(TRUE(),(Max_Year - min_year)>=15,15,(Max_Year - min_year)<10,BLANK(),(Max_Year - min_year)=14,14,(Max_Year - min_year)=13,13,(Max_Year - min_year)=12,12,(Max_Year - min_year)=11,11,(Max_Year - min_year)=10,10,BLANK()) */
			
			var longgvalue = CALCULATE(MAX('_Overvieww Target'[Target Value]),  FILTER('Indicator Dimensions',NOT ISBLANK('Indicator Dimensions'[Target Year]) && 
			                        'Indicator Dimensions'[Indicator]=VALUES('_Overvieww Target'[Indicator]  )))
			
			var expo = 1/longexpo
			return
			 IF(ISBLANK([Long_BeginnningValue1]),BLANK(),((DIVIDE(longgvalue,[Long_BeginnningValue1])^(expo)) - 1 ) * 100) 
			```
		lineageTag: 6a81f847-7487-4ca1-a50e-6305eb94e1b9

	measure CAGR-TargetShorTermT =
			
			//var target = Max
			var Max_Year = MAX(_Goal1_Overview[TIME_PERIOD])
			var targetyear = 2030
			var T = /* CALCULATE(SUM('Overvieww Target'[Target Value])) */ CALCULATE(Max('_Overvieww Target'[Target Value]), _Goal1_Overview[Indicator] = _Goal1_Overview[Indicator])
			Var Indi = SELECTEDVALUE(_Goal1_Overview[Indicator])
			
			var shorttermyear =  [MaxYearMinus3or5_Overvieww]
			var denominator = IF(Indi = "sdg_05_60", 2026 - shorttermyear,targetyear - shorttermyear )
			var shortbeg = [ShortTermBeginningValue1]
			var targetShortTerm =  ((DIVIDE(T,shortbeg)^(1/denominator))-1)*100
			return IF(ISBLANK([ShortTermBeginningValue1]),BLANK(),targetShortTerm)
