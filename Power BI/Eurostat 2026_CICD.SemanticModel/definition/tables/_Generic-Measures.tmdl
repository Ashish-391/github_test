table _Generic-Measures
	lineageTag: 9f54d4c6-6791-4cd8-8d67-8be48491a8ad

	measure MaxYearMinus3or5 = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			VAR MaxYearVal = [1CY]
			/* VAR MaxYearMinus5Val = IF((MaxYearVal - 5)=2020,MaxYearVal-4,MaxYearVal-5)
			VAR MaxYearMinus4Val = IF(( MaxYearVal - 4)=2020,MaxYearVal-3,MaxYearVal-4)
			VAR MaxYearMinus3Val = IF(( MaxYearVal - 3)=2020, MaxYearVal-4,MaxYearVal-3)
			Var MaxYearMinus6Val = MaxYearVal - 6 */
			VAR ExcludedYear = 2020
			
			VAR MaxYearMinus5Val =
			    VAR y1 = MaxYearVal - 5
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus4Val =
			    VAR y1 = MaxYearVal - 4
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus3Val =
			    VAR y1 = MaxYearVal - 3
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus6Val =
			    VAR y1 = MaxYearVal - 6
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			Var sd = BLANK()
			
			RETURN
			    if( indicator = "SDG_15_10",(IF( 
			        CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_03_30",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_15_50*",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_15_50",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_10_60",sd,
			        If(CALCULATE(COUNTROWS(FILTER(Goal1, Goal1[Year] = MaxYearMinus5Val && Goal1[CountryAbrv]="EU27_2020")), ALLEXCEPT(Goal1, Goal1[IndicatorValue])) > 0,
			        CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus5Val,Goal1[CountryAbrv]="EU27_2020"),
			        If(CALCULATE(COUNTROWS(FILTER(Goal1, Goal1[Year] = MaxYearMinus4Val && Goal1[CountryAbrv]="EU27_2020")), ALLEXCEPT(Goal1, Goal1[IndicatorValue])) > 0,
			        CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus4Val ,Goal1[CountryAbrv]="EU27_2020"),
			         CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus3Val,Goal1[CountryAbrv]="EU27_2020")
			    ))))))),
			    IF( 
			        CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_03_30",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_15_50*",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_15_50",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_10_60",sd,
			        If(CALCULATE(COUNTROWS(FILTER(Goal1, Goal1[Year] = MaxYearMinus5Val && Goal1[CountryAbrv]=countrySelect)), ALLEXCEPT(Goal1, Goal1[IndicatorValue])) > 0,
			        CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus5Val,Goal1[CountryAbrv]=countrySelect),
			        If(CALCULATE(COUNTROWS(FILTER(Goal1, Goal1[Year] = MaxYearMinus4Val && Goal1[CountryAbrv]=countrySelect)), ALLEXCEPT(Goal1, Goal1[IndicatorValue])) > 0,
			        CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus4Val ,Goal1[CountryAbrv]=countrySelect),
			         CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus3Val,Goal1[CountryAbrv]=countrySelect)
			    )))))))
			```
		lineageTag: da27423d-e49d-4b0b-b91f-e539bd4787fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ShortTermValue = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			VAR MaxYearVal = [1CY]
			/* VAR MaxYearMinus3Val = IF(( MaxYearVal - 3)=2020, MaxYearVal-4,MaxYearVal-3)
			VAR MaxYearMinus4Val = MaxYearVal - 4
			VAR MaxYearMinus5Val = MaxYearVal - 5
			Var MaxYearMinus6Val = MaxYearVal - 6 */
			VAR ExcludedYear = 2020
			
			VAR MaxYearMinus5Val =
			    VAR y1 = MaxYearVal - 5
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus4Val =
			    VAR y1 = MaxYearVal - 4
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus3Val =
			    VAR y1 = MaxYearVal - 3
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus6Val =
			    VAR y1 = MaxYearVal - 6
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			Var sd = BLANK()
			
			Var MaxYearMinus3or5_15_10 =  if(indicator = "SDG_15_10", IF( 
			        CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_03_30",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_15_50*",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_15_50",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_10_60",sd,
			        If(CALCULATE(COUNTROWS(FILTER(Goal1, Goal1[Year] = MaxYearMinus5Val && Goal1[CountryAbrv]="EU27_2020")), ALLEXCEPT(Goal1, Goal1[IndicatorValue])) > 0,
			        CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus5Val,Goal1[CountryAbrv]="EU27_2020"),
			        If(CALCULATE(COUNTROWS(FILTER(Goal1, Goal1[Year] = MaxYearMinus4Val && Goal1[CountryAbrv]="EU27_2020")), ALLEXCEPT(Goal1, Goal1[IndicatorValue])) > 0,
			        CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus4Val ,Goal1[CountryAbrv]="EU27_2020"),
			         CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus3Val,Goal1[CountryAbrv]="EU27_2020")
			    )))))))
			
			Var MaxYearMinus3or5 =   IF( 
			        CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_03_30",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_15_50*",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_15_50",CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(Goal1[IndicatorValue]))="SDG_10_60",sd,
			        If(CALCULATE(COUNTROWS(FILTER(Goal1, Goal1[Year] = MaxYearMinus5Val && Goal1[CountryAbrv]=countrySelect)), ALLEXCEPT(Goal1, Goal1[IndicatorValue])) > 0,
			        CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus5Val,Goal1[CountryAbrv]=countrySelect),
			        If(CALCULATE(COUNTROWS(FILTER(Goal1, Goal1[Year] = MaxYearMinus4Val && Goal1[CountryAbrv]=countrySelect)), ALLEXCEPT(Goal1, Goal1[IndicatorValue])) > 0,
			        CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus4Val ,Goal1[CountryAbrv]=countrySelect),
			         CALCULATE(MAX(Goal1[Year]), Goal1[Year] = MaxYearMinus3Val,Goal1[CountryAbrv]=countrySelect)
			    ))))))
			RETURN
			if(indicator = "SDG_15_10",CALCULATE(MAX(Goal1[Value]),Goal1[Year]=MaxYearMinus3or5_15_10,ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[CountryAbrv]="EU27_2020"),
			CALCULATE(MAX(Goal1[Value]),Goal1[Year]=MaxYearMinus3or5,ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[CountryAbrv]=countrySelect))
			```
		lineageTag: 8cd09ecf-5241-41d7-b83e-455ac63f4cbc

