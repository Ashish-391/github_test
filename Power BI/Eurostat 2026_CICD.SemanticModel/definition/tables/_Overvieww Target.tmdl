	column YearValueT = ```
			var Max_Year = [MaxxYear_Overview]
			            /*  var min_year2 = CALCULATE(MIN(Goal1_Overview[TIME_PERIOD])) */
			var logg =  SELECTEDVALUE('Indicator Dimensions'[Indicator])    
			var min_year = CALCULATE(MIN(_Goal1_Overview[TIME_PERIOD]))
			var longtermYear = [Long_Term_Year]
			var shortyear = [MaxYearMinus3or5_Overvieww]
			
			return
			SWITCH(TRUE(),  '_Overvieww Target'[Year-Label]="Short Term" && ISBLANK(shortyear),"Time series too short", 
			               '_Overvieww Target'[Year-Label]="Short Term" , shortyear & "-" & Max_Year, 
			              '_Overvieww Target'[Year-Label]="Long Term" &&  not ISBLANK(longtermYear),longtermYear & "-" & Max_Year,
			              '_Overvieww Target'[Year-Label]="Long Term" && ISBLANK(longtermYear)," Time series too short") 
