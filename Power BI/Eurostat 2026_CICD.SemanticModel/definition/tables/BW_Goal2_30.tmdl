	partition BW_Goal2_30 = calculated
		mode: import
		source =
				
				var indicator = "SDG_02_30"
				//Var maxDate = CALCULATE(MAX(All_SDG_Goal_2[UpdatedFromDate]),All_SDG_Goal_2[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX(All_SDG_Goal_2[Time_Period]),All_SDG_Goal_2[Indicator]=indicator,All_SDG_Goal_2[Geo]="EU27_2020")
				RETURN
				FILTER
