	column Sorting = IF(BW_Goal10_60[Year]=MAX(BW_Goal10_60[Year]),(MAX(BW_Goal10_60[Year])&BW_Goal10_60[Value]),BLANK())
		dataType: double
		lineageTag: fb46951b-4e5f-40fd-a1cf-04bbb2656a8a
