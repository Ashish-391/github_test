	column Geo
		lineageTag: 25dddd67-dac4-4e31-8e58-2cda4021ef89
		summarizeBy: none
		isNameInferred
		sourceColumn: [Geo]

		annotation SummarizationSetBy = Automatic

	partition BW_Goal2_20 = calculated
		mode: import
		source =
				
				var indicator = "SDG_02_20"
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal_2'[Time_Period]),'All_SDG_Goal_2'[Indicator]=indicator,'All_SDG_Goal_2'[Geo]="EU27_2020")
				
				RETURN
				
				    SELECTCOLUMNS (
				
				        FILTER
				
				('All_SDG_Goal_2',('All_SDG_Goal_2'[Time_Period]= maxTime_Period
				
				||
				
				'All_SDG_Goal_2'[Time_Period]=maxTime_Period-5
				
				) && 'All_SDG_Goal_2'[Indicator]=indicator),
				
				        "Year", 'All_SDG_Goal_2'[Time_Period],
				
				        "Value", 'All_SDG_Goal_2'[OBS_VALUE],
				
				        "Geo", 'All_SDG_Goal_2'[Geo]
				
				    )

	annotation PBI_Id = bd586dfde8ce4a8ca10ff33196ace6f6

