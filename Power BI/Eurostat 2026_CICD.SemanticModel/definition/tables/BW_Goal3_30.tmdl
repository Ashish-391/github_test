	partition BW_Goal3_30 = calculated
		mode: import
		source =
				
				var indicator = "SDG_03_30"
				var sex = "T"
				//Var maxDate = CALCULATE(MAX(All_SDG_Goal3[UpdatedFromDate]),All_SDG_Goal3[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX(All_SDG_Goal3[Time_Period]),All_SDG_Goal3[Indicator]=indicator,All_SDG_Goal3[Geo]="EU27_2020",All_SDG_Goal3[Sex] = sex)
				RETURN
				FILTER
				(All_SDG_Goal3,(All_SDG_Goal3[Time_Period]= maxTime_Period
				||
				All_SDG_Goal3[Time_Period]=maxTime_Period-6
				) && All_SDG_Goal3[Indicator]=indicator && All_SDG_Goal3[Sex] = sex )

	annotation PBI_Id = bef91d8343a449058d9588ca8cf5b1d2

