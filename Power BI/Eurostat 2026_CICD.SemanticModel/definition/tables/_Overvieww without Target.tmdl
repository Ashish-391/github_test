	column 'Assessment Arrows' = '_Overvieww without Target'[CAGR_WT_1] * '_Overvieww without Target'[Dim]
		lineageTag: 3a241f28-e072-4aa5-b498-6744cc8fc5a7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column CAGR_WT_1 = ```
			var cagr_wt = 
			SWITCH('_Overvieww without Target'[Year-Label] ,"Short Term" ,[CAGR_ShortTerm_WT],"Long Term",[CAGR_LongTerm_WT])
			return cagr_wt
			```
		formatString: 0
		lineageTag: 315757bf-a617-4d39-b06c-e9fc9034ae39
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Icon Trend' = ```
			SWITCH(TRUE(),
			ISBLANK('_Overvieww without Target'[Assessment Arrows]),
			"data:image/png;base64,",
			--Red down
			'_Overvieww without Target'[Assessment Arrows] <= -0.95,"data:image/png;base64,",
			--Green arrow up
			'_Overvieww without Target'[Assessment Arrows] >= 0.95 ,"data:image/png;base64,",
			
			--Zero arrow
			'_Overvieww without Target'[Assessment Arrows] <= 0.149 && '_Overvieww without Target'[Assessment Arrows] >= -0.149,"data:image/png;base64,",
			 
			--Green arrow slight up
			'_Overvieww without Target'[Assessment Arrows] < 0.95 && '_Overvieww without Target'[Assessment Arrows] > 0.149,"data:image/jpeg;base64,",
			 
			 
			--Red slight down
			'_Overvieww without Target'[Assessment Arrows] < -0.149 && '_Overvieww without Target'[Assessment Arrows] >-0.95,"data:image/jpeg;base64,",
			--Yellow flat arrow
			'_Overvieww without Target'[Assessment Arrows] <= 0.15 && '_Overvieww without Target'[Assessment Arrows] >=-0.15,
			"data:image/png;base64,",
			--Cross IH4Q
			ISBLANK('_Overvieww without Target'[Assessment Arrows]),
			"data:image/png;base64,"
			 
			)
			```
		lineageTag: 0e486c0a-1638-4a36-93e1-cd84941b07fe
		dataCategory: ImageUrl
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'YearValue WT' = ```
			
			var Max_Year1 = CALCULATE(MAX(_Goal1_Overview[TIME_PERIOD])) 
			var min_year2 = CALCULATE(MIN(_Goal1_Overview[TIME_PERIOD]))
			var longterm = Max_Year1 - min_year2
			
			var Max_Year = CALCULATE(MAX(_Goal1_Overview[TIME_PERIOD])) 
			var shortyear =   [MaxYearMinus3or5_Overvieww]
			var min_year = CALCULATE(MIN(_Goal1_Overview[TIME_PERIOD]))
			var longtermYear = [Long_Term_Year]
			
			return
			SWITCH(TRUE(),
			             '_Overvieww without Target'[Year-Label]="Short Term" && ISBLANK(shortyear),"Time series too short",
			             '_Overvieww without Target'[Year-Label]="Short Term" ,shortyear & "-" & Max_Year, 
			              '_Overvieww without Target'[Year-Label]="Long Term" &&  not ISBLANK(longtermYear),longtermYear & "-" & Max_Year,
			              '_Overvieww without Target'[Year-Label]="Long Term" && ISBLANK(longtermYear),"Time series too short"
			              
			              )
			```
		lineageTag: 7d0ce09a-9acd-4a45-8dbd-a8429eeda67a
		summarizeBy: none

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

