	column Sorting =
			
			var indicator = "SDG_06_20"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator)
			RETURN
			IF(BW_Goal6_20[Year]=maxTime_Period,maxTime_Period&ABS(BW_Goal6_20[Value]),BLANK())
		dataType: double
		lineageTag: 4e722922-dcc3-4b76-bfe8-83c8dbe69c9a
