	column Sorting =
			
			var indicator = "SDG_17_10"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[TIME_PERIOD]),'All_SDG_Goal5-12'[Indicator]=indicator)
			RETURN
			IF(BW_Goal17_10[Year]=maxTime_Period,maxTime_Period&BW_Goal17_10[Value],BLANK())
