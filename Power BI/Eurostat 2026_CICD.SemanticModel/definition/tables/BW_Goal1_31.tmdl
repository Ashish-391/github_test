	column Sorting = IF(BW_Goal1_31[TIME_PERIOD]=MAX(BW_Goal1_31[TIME_PERIOD]),MAX(BW_Goal1_31[TIME_PERIOD])&BW_Goal1_31[Value],BLANK())
		dataType: double
		lineageTag: 38be43f2-84ce-40dc-a0ee-2c40ae21009d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

