	partition 'BW_Goal hlth_silc_17' = calculated
		mode: import
		source =
				
				var indicator = "hlth_silc_17"
				var sex = "Total"
				//Var maxDate = CALCULATE(MAX(All_SDG_Goal3[UpdatedFromDate]),All_SDG_Goal3[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX(All_SDG_Goal3[Time_Period]),All_SDG_Goal3[Indicator]=indicator,All_SDG_Goal3[Geo]="EU27_2020",All_SDG_Goal3[Sex]="Total")
				RETURN
				FILTER
				(All_SDG_Goal3,(All_SDG_Goal3[Time_Period]= maxTime_Period
				||
				All_SDG_Goal3[Time_Period]=maxTime_Period-5
				) && All_SDG_Goal3[Indicator]=indicator && All_SDG_Goal3[Sex]=sex)

	annotation PBI_Id = e74049b02847437b9eab3fbeb2244493

