	column Sorting =
			
			var indicator = "SDG_04_70"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal4'[Time_Period]),'All_SDG_Goal4'[Indicator]=indicator)
			RETURN
			IF(BW_Goal4_70[Year]=maxTime_Period,maxTime_Period&BW_Goal4_70[Value],BLANK())
		dataType: double
		lineageTag: 238602f1-e2c1-4e86-913c-3b305cfb9819
		summarizeBy: sum

