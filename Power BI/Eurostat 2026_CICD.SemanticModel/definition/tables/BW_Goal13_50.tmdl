	column Sorting =
			
			var indicator = "SDG_13_50"
			var maxTime_Period = CALCULATE(MAX(All_SDG_Goal12[TIME_PERIOD]),All_SDG_Goal12[Indicator]=indicator)
			RETURN
			IF(BW_Goal13_50[Year]=maxTime_Period,maxTime_Period&BW_Goal13_50[Value],BLANK())
		dataType: double
		lineageTag: bec45d45-cef7-412f-998d-20e03a45fa91
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition BW_Goal13_50 = calculated
		mode: import
		source = ```
				
				
				var indicator = "SDG_13_50"
				//Var maxDate = CALCULATE(MAX('Goal 4 BW'[UpdatedFromDate]),'Goal 4 BW'[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX(All_SDG_Goal12[TIME_PERIOD]),All_SDG_Goal12[Indicator]=indicator,All_SDG_Goal12[Geo]="EU27_2020")
				RETURN
				    SELECTCOLUMNS (
				        FILTER
				(All_SDG_Goal12,(All_SDG_Goal12[TIME_PERIOD]= maxTime_Period
				||
				All_SDG_Goal12[TIME_PERIOD]=maxTime_Period-5
				) && All_SDG_Goal12[Indicator]=indicator),
				        "Year", All_SDG_Goal12[TIME_PERIOD],
				        "Value", All_SDG_Goal12[OBS_VALUE],
				        "Geo", All_SDG_Goal12[Geo]
				    ) 
				
				```

	annotation PBI_Id = ce1c1d878e9f4132a855859c12a4b29c

