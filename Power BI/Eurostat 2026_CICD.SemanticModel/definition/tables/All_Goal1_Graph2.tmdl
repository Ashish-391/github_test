	partition All_Goal1_Graph2 = calculated
		mode: import
		source = ```
				
				var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
				var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
				var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
				var maxyear = CALCULATE(MAX(Goal1[Year]),Goal1[CountryAbrv]="EU27_2020",Goal1[UpdatedFromDate]=MAX(Goal1[UpdatedFromDate]))
				RETURN
				FILTER(Goal1,((Goal1[Year]=maxyear || Goal1[Year] = maxyear-5 ) && Goal1[UpdatedFromDate]=MAX(Goal1[UpdatedFromDate])))
				```

	annotation PBI_Id = 58b7cd6943d940ceaa78c48d12d9e056

