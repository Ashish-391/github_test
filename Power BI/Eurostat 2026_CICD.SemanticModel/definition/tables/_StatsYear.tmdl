table _StatsYear
	lineageTag: 92090b56-3c3d-41cf-8715-8b583034c4c6

	measure 1CY = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			RETURN
			if(indicator = "SDG_15_10",CALCULATE(MAX('Goal1'[Year]),Goal1[CountryAbrv]="EU27_2020",ALLSELECTED(Goal1[UpdatedFromDate])),
			CALCULATE(MAX('Goal1'[Year]),Goal1[CountryAbrv]=countrySelect,ALLSELECTED(Goal1[UpdatedFromDate])))
			```
		formatString: 0
		lineageTag: fd8c8ddd-39b8-45d1-b7f3-4a9470b27281

	measure 2PY = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			var CY = CALCULATE(MAX('Goal1'[Year]),Goal1[CountryAbrv]=countrySelect,ALLSELECTED(Goal1[UpdatedFromDate]))
			var MaxYearMinus1 = CALCULATE(MAX('Goal1'[Year]),Goal1[CountryAbrv]=countrySelect,ALLSELECTED(Goal1[UpdatedFromDate]),'Goal1'[Year]<CY)
			var py = IF(CY - 1 = MaxYearMinus1, CY -1,
			    IF(CY -2 = MaxYearMinus1, CY -2,
			        (IF(CY -3 = MaxYearMinus1, CY -3,
			          IF(CY -4 = MaxYearMinus1, CY -4,BLANK()))))) 
			var priorValue = CALCULATE(MAX(Goal1[Value]),Goal1,Goal1[Year]=py,Goal1[CountryAbrv]=countrySelect)
			RETURN 
			IF(priorValue=BLANK(),"",py)
			//CALCULATE(MAX(Goal1[Year]),FILTER(Goal1,Goal1[UpdatedFromDate]=ALLSELECTED(Goal1[UpdatedFromDate]) && Goal1[Year]<>MAX(Goal1[Year])))
			```
		formatString: 0
		lineageTag: be7205a4-6b5e-4310-8875-6779338f5c56

	measure 3TY =
			
			var indicator = CALCULATE(SELECTEDVALUE(Goal1[IndicatorValue]),USERELATIONSHIP(Goal1[IndicatorValue],'Target Values'[Indicator Name]))
			RETURN
			CALCULATE(MAX('Target Values'[Target Year]),'Target Values'[Indicator Name]=indicator)
		formatString: 0
		lineageTag: d4da6f35-9a9b-4b14-a233-ab3ecfba02f6

	measure 4ST = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			VAR MaxYearVal = [1CY]
			/* VAR MaxYearMinus5Val = IF((MaxYearVal - 5)=2020,MaxYearVal-4,MaxYearVal-5)
			VAR MaxYearMinus4Val = IF(( MaxYearVal - 4)=2020,MaxYearVal-3,MaxYearVal-4)
			VAR MaxYearMinus3Val = IF(( MaxYearVal - 3)=2020, MaxYearVal-4,MaxYearVal-3) 
			var MaxYearMinus6Val = MaxYearVal - 6 */
			VAR ExcludedYear = 2020
			
			VAR MaxYearMinus5Val =
			    VAR y1 = MaxYearVal - 5
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus4Val =
			    VAR y1 = MaxYearVal - 4
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus3Val =
			    VAR y1 = MaxYearVal - 3
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus6Val =
			    VAR y1 = MaxYearVal - 6
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			var ST_ValueForYear5 = CALCULATE(MAX(Goal1[Value]),Goal1[Year]=MaxYearMinus5Val,Goal1[CountryAbrv]=countrySelect,ALLSELECTED(Goal1[UpdatedFromDate]))
			var ST_ValueForYear4 = CALCULATE(MAX(Goal1[Value]),Goal1[Year]=MaxYearMinus4Val,Goal1[CountryAbrv]=countrySelect,ALLSELECTED(Goal1[UpdatedFromDate]))
			var ST_ValueForYear3 = CALCULATE(MAX(Goal1[Value]),Goal1[Year]=MaxYearMinus3Val,Goal1[CountryAbrv]=countrySelect,ALLSELECTED(Goal1[UpdatedFromDate]))
			
			
			var ST_ValueForYear52 = CALCULATE(MAX(Goal1[Value]),Goal1[Year]=MaxYearMinus6Val,Goal1[CountryAbrv]=countrySelect,ALLSELECTED(Goal1[UpdatedFromDate]))
			var sdg15_50 = IF(ST_ValueForYear5=BLANK(),ST_ValueForYear52,ST_ValueForYear5)
			
			RETURN
			IF(indicator="SDG_04_40" || indicator="SSG_04_40" || indicator="SMG_04_40" ,MaxYearMinus4Val,
			IF((indicator="SDG_15_50" || indicator = "SDG_03_30") && ST_ValueForYear5=BLANK(),MaxYearMinus6Val,
			//IF(indicator="SDG_04_70",[1CY]-2,
			IF(ST_ValueForYear5=BLANK(),IF(ST_ValueForYear4=BLANK(),IF(ST_ValueForYear3=BLANK(),"",MaxYearMinus3Val),MaxYearMinus4Val),MaxYearMinus5Val)
			  )
			  )
			```
		lineageTag: 47234813-04fb-403f-bc32-1d7ddfc6aac9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 5LT = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			VAR Max_Year = CALCULATE(MAX(Goal1[Year]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[CountryAbrv]=countrySelect)
			var min_year = CALCULATE(MIN(Goal1[Year]),ALLSELECTED(Goal1[UpdatedFromDate]))
			//var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			RETURN
			IF(indicator="SDG_15_50",Max_Year-16,
			 IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 15 && NOT ISBLANK(Goal1[Value]) && Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-15,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 14 && NOT ISBLANK(Goal1[value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-14,
			        IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 13 && NOT ISBLANK(Goal1[value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-13,
			            IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 12 && NOT ISBLANK(Goal1[value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-12,
			                IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 11 && NOT ISBLANK(Goal1[value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-11,
			                    IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 10 && NOT ISBLANK(Goal1[value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-10,
			     BLANK()
			                        )
			                    )
			                )
			            )
			        )
			     
			     )
			)
			```
		formatString: 0
		lineageTag: a6f29c7c-29ce-49c7-8240-048016c527e5

	measure 'Peak Year' = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			var maxvalue = CALCULATE(MAX(Goal1[Value]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[CountryAbrv]=countrySelect,Goal1[IndicatorValue]=indicator)
			RETURN
			CALCULATE(MAX(Goal1[Year]),Goal1[Value]=maxvalue,ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[IndicatorValue]=indicator,Goal1[CountryAbrv]=countrySelect)
			```
		formatString: 0
		lineageTag: 0938f8c5-1f35-4408-9c81-8a272d4cd98d

	measure 'Low Year' = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			var minvalue = CALCULATE(MIN(Goal1[Value]),Goal1[CountryAbrv]=countrySelect,ALLSELECTED(Goal1[UpdatedFromDate]))
			RETURN
			CALCULATE(MAX(Goal1[Year]),Goal1[Value]=minvalue,Goal1[CountryAbrv]=countrySelect,ALLSELECTED(Goal1[UpdatedFromDate]))
			```
