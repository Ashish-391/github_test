	measure Overvieww_CAGRLongTerm_Observed = ```
			
			 var Max_Year = [MaxxYear_Overview]
			var min_year = CALCULATE(MIN(_Goal1_Overview[TIME_PERIOD]))
			var longtermYear = SWITCH(TRUE(),(Max_Year - min_year)>=15,Max_Year-15,(Max_Year - min_year)<10,BLANK(),(Max_Year - min_year)=14,Max_Year-14,(Max_Year - min_year)=13,Max_Year-13,(Max_Year - min_year)=12,Max_Year-12,(Max_Year - min_year)=11,Max_Year-11,(Max_Year - min_year)=10,Max_Year-10,BLANK())
			
			var longexpo = 
			IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 15 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     15,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 14 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     14,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 13 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     13,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 12 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     12,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 11 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     11,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 10 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     10,BLANK()
			     )))))
			     )
			var expo = 1/longexpo
			return
			IF(ISBLANK([Long_BeginnningValue1]),BLANK(),(( DIVIDE([Ending ValueT],[Long_BeginnningValue1],0)^(expo)) - 1 ) * 100)
			```
		lineageTag: ac0af365-4c13-4f17-aa7a-e34389daa0ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ShortTermBeginningValue1 = ```
			
			 VAR MaxYearVal = [MaxxYear_Overview]
			/* VAR MaxYearMinus4Val = MaxYearVal - 4
			VAR MaxYearMinus3Val = MaxYearVal - 3 */
			VAR ExcludedYear = 2020
			VAR MaxYearMinus4Val =
			    VAR y1 = MaxYearVal - 4
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus3Val =
			    VAR y1 = MaxYearVal - 3
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			var a = SELECTEDVALUE('_Overvieww Target'[Indicator])
			var a14_10= SELECTEDVALUE(_Goal1_Overview[Indicator])
			Return
			SWITCH(TRUE(),
			  a14_10="SDG_14_10", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus3Val), 
			a="SDG_04_40" || a="SDG_17_60" ||a="SDG_17_60*" , CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus4Val),
			a="SMG_04_40", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus4Val),
			a="SSG_04_40", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus4Val),
			CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MAX(_Goal1_Overview[TIME_PERIOD])-5,_Goal1_Overview[Indicator]=a)
			) 
			```
