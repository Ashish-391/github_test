	column CAGR_Target = ```
			
			//SWITCH(Overvieww[Year-Label],"Short Term",[CAGR_ShortTerm],[CAGR_LongTerm])
			var cagr = SWITCH('_Overvieww Target'[Year-Label] & ('_Overvieww Target'[CAGR-Header]), 
			"Short Term" & "Observed",[CAGR_ShortTerm_T],
			"Short Term" & "Required" ,IF(NOT ISBLANK('_Overvieww Target'[Target Year]), [CAGR-TargetShorTermT]),
			"Long Term" & "Observed", [Overvieww_CAGRLongTerm_Observed],
			"Long Term" & "Required", [CAGR-TargetLongTerm T]
			)
			return cagr
