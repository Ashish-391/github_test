	measure Year_Calculation = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var maxYear = [1CY]
			var maxYear_Value = CALCULATE(MAX(eu_Goal1[Value]),eu_Goal1[UpdatedFromDate]=ALLSELECTED(Goal1[UpdatedFromDate]),eu_Goal1[IndicatorValue]=indicator,eu_Goal1[Year]=maxYear)
			var BW_Year = IF(ISBLANK(maxYear_Value),CALCULATE(MAX(eu_Goal1[Year]),eu_Goal1[UpdatedFromDate]=ALLSELECTED(Goal1[UpdatedFromDate]),eu_Goal1[IndicatorValue]=indicator),[1CY])
			var bestWorstYear = IF(indicator="SDG_04_10*" || indicator="SDG_04_20*" || indicator="SDG_01_10A"|| indicator="SDG_01_20A" || indicator="SDG_04_10A"|| indicator="SDG_08_20A"|| indicator="SDG_08_30A" || indicator="SDG_12_10" || indicator="SDG_15_60" || indicator="SDG_15_61" || indicator="SDG_14_21" || indicator="SDG_14_30" || indicator="SDG_14_51" || indicator="SDG_17_20" || indicator="SDG_17_30" ,"NA", FORMAT(BW_Year,"0"))
			RETURN
			SWITCH(SELECTEDVALUE('Datapoints-List'[Index]),
			                            1,IF([1CY]=BLANK(),"-",FORMAT([1CY],"0")),
			                            2,IF(indicator="SDG_05_10","NA",IF([2PY]=BLANK(),"NA",FORMAT([2PY],"0"))),
			                            3,IF(indicator="SDG_05_10","NA",IF([3TY]=BLANK(),"NA",FORMAT([3TY],"0"))),
			                            4,IF(indicator="SDG_05_10","NA",IF([4ST]=BLANK(),"Time series too short",FORMAT([4ST],"0"))),
			                            5,IF(indicator="SDG_05_10","NA",IF([5LT]=BLANK(),"Time series too short",FORMAT([5LT],"0"))),
			                            6,IF(indicator="SDG_05_10","NA",IF([1CY]=BLANK() || [2PY]=BLANK(),"NA",[Change YOY])),
			                            7,IF(indicator="SDG_05_10","NA",IF([4ST]=BLANK(),"NA",[Change Short Term])),
			                            8,IF(indicator="SDG_05_10","NA",IF([5LT]=BLANK(),"Time series too short",[Change Long Term])),
			                            9,IF(indicator="SDG_05_10","NA",IF([4ST]=BLANK() || indicator="SDG_10_60","Time series too short",[Year_CAGRShort_Term_Observed])),
			                            10,IF(indicator="SDG_05_10","NA",IF([3TY]=BLANK() ,"NA",IF([4ST]=BLANK(),"Time series too short",[Year_CAGRShortTerm_required]))),
			                            11,IF(indicator="SDG_05_10","NA",IF([3TY]=BLANK() ,"NA",IF([4ST]=BLANK(),"Time series too short",[CAGRShortRatio]))),
			                            12,IF(indicator="SDG_05_10","NA",IF([5LT]=BLANK(),"Time series too short",[Year_CAGRLongTerm_Observed])),
			                            13,IF(indicator="SDG_05_10","NA",IF([3TY]=BLANK(),"NA",IF([5LT]=BLANK(),"Time series too short",[YearCAGRLongTerm_Required]))),
			                            14,IF(indicator="SDG_05_10","NA",If([3TY]=BLANK(),"NA",IF([5LT]=BLANK(),"Time series too short",[CAGRLongRatio]))),
			                            17,IF(indicator="SDG_05_10","NA",IF([Peak Year]=BLANK(),"NA",FORMAT([Peak Year],"0"))),
			                            18,IF(indicator="SDG_05_10","NA",IF([Low Year]=BLANK(),"NA",FORMAT([Low Year],"0"))),
			                            19,IF(indicator="SDG_05_10","NA",[Change since Peak]),
			                            20,IF(indicator="SDG_05_10","NA",[Change since Low]),
			                            21,IF(indicator="SDG_05_10","NA",[Covid 19 Impact]),
			                            22,IF(indicator="SDG_05_10","NA",[Pre-COVID-19]),
			                            23,IF(indicator="SDG_05_10","NA",[CovidRecoverLabel]),
			                            24,IF([1CY]=BLANK(),"-",bestWorstYear),
			                            25,IF([1CY]=BLANK(),"-",bestWorstYear),
			                            26,IF([1CY]=BLANK(),"-",bestWorstYear),
			                            27,IF([1CY]=BLANK(),"-",bestWorstYear),
			                            28,IF([1CY]=BLANK(),"-",bestWorstYear),
			                            29,IF([1CY]=BLANK(),"-",bestWorstYear)
			                            
			                            
			                            
			                            
			                            
			                            
			                            
			    
			                            )
			```
		lineageTag: 607112f8-73be-471d-a3ff-c65528d32b54

	measure BestWorst_Year =
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var maxyear = CALCULATE(MAX(eu_Goal1[Year]),eu_Goal1[IndicatorValue]=indicator,eu_Goal1[CountryAbrv]="EU27_2020")
			RETURN
			CALCULATE(MAX(eu_Goal1[Year]),ALLSELECTED(Goal1[UpdatedFromDate]),eu_Goal1[IndicatorValue]=indicator,eu_Goal1[CountryAbrv]="EU27_2020")
