	partition BW_Goal17_10 = calculated
		mode: import
		source = ```
				
				
				var indicator = "SDG_17_10"
				var partner = "ODA" 
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator,'All_SDG_Goal5-12'[Geo]="EU27_2020", 'All_SDG_Goal5-12'[partner] = partner)
				
				RETURN
				
				    SELECTCOLUMNS (
				
				        FILTER
				
				('All_SDG_Goal5-12',('All_SDG_Goal5-12'[Time_Period]= maxTime_Period
				
				||
				
				'All_SDG_Goal5-12'[Time_Period]=maxTime_Period-5
				
				) && 'All_SDG_Goal5-12'[Indicator]=indicator && 'All_SDG_Goal5-12'[partner] = partner),
				
				        "Year", 'All_SDG_Goal5-12'[Time_Period],
				
				        "Value", 'All_SDG_Goal5-12'[OBS_VALUE],
				
				        "Geo", 'All_SDG_Goal5-12'[Geo]
				
				    )
				```

