	column YearValue2 = ```
			
			var indicator = SELECTEDVALUE(_Goal1_Overview[Indicator])
			var Max_Year1 = CALCULATE(MAX(_Goal1_Overview[TIME_PERIOD]))
			var min_year2 = CALCULATE(MIN(_Goal1_Overview[TIME_PERIOD]),_Goal1_Overview[Indicator] = indicator)
			var longterm = Max_Year1 - min_year2
			var Max_Year = [MaxxYear]
			var shortyear = [MaxYearMinus3or5_Overvieww]  
			var min_year = CALCULATE(MIN(_Goal1_Overview[TIME_PERIOD]),_Goal1_Overview[Indicator] = indicator)
			var longtermYear = [Long_Term_Year]
			return
			
			SWITCH(TRUE(),
			        _Overvieww[Year-Label] = "Short Term" && ISBLANK(shortyear), "Short Term " & "Time series too short",
			        _Overvieww[Year-Label]="Short Term" ,"Short Term " & shortyear & "-" & Max_Year1, 
			        _Overvieww[Year-Label]="Long Term" &&  not ISBLANK(longtermYear),"Long Term " & longtermYear & "-" & Max_Year1,
			        _Overvieww[Year-Label] = "Long Term" && ISBLANK(longtermYear), "Long Term " & "Time series too short")
			```
		lineageTag: d68cdec3-7020-472f-af15-145e3bdecb91
		summarizeBy: none
		sortByColumn: Year-Label

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

