	column Sorting =
			
			var indicator = "SDG_08_11"
			//var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-6-7'[Time_Period]),'All_SDG_Goal5-6-7'[Indicator]=indicator,'All_SDG_Goal5-6-7'[Geo]="EU27_2020")
			RETURN
			
