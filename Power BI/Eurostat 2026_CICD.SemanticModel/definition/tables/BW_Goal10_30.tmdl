	column CountryAbrv
		lineageTag: 3f06d7d2-4198-430c-b8da-972b1d280ec0
		summarizeBy: none
		isNameInferred
		sourceColumn: [CountryAbrv]

		annotation SummarizationSetBy = Automatic

	column Sorting =
			
			var indicator = "SDG_10_30"
			var maxYear = CALCULATE(MAX(Goal1[Year]),Goal1[IndicatorValue]=indicator,Goal1[CountryAbrv]="EU27_2020")
			RETURN
			IF(BW_Goal10_30[Year]=maxYear,maxYear&BW_Goal10_30[Value],BLANK())
		dataType: double
		lineageTag: e3a1f02e-b648-4553-94ff-2904650bfc78
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition BW_Goal10_30 = calculated
		mode: import
		source =
				
				VAR indicator = "SDG_10_30"
				VAR maxYear = CALCULATE(MAX(Goal1[Year]), Goal1[IndicatorValue] = indicator, Goal1[CountryAbrv] = "EU27_2020", Goal1[Unit] = "PC")
				RETURN
				    SELECTCOLUMNS (
				        FILTER (
				            Goal1,
				            (Goal1[Year] = maxYear || Goal1[Year] = maxYear - 5) && Goal1[IndicatorValue] = indicator && Goal1[Unit] = "PC"
				        ),
				        "Year", Goal1[Year],
				        "Value", Goal1[Value],
				        "CountryAbrv", Goal1[CountryAbrv]
				    )

	annotation PBI_Id = 407a19624b4d4f1894aea8bd28dbb3da

