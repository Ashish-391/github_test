	partition BW_Goal14_60 = calculated
		mode: import
		source = ```
				
				
				var indicator = "SDG_14_60"
				var unit = "PC"
				//Var maxDate = CALCULATE(MAX('Goal 4 BW'[UpdatedFromDate]),'Goal 4 BW'[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX(All_SDG_Goal12[TIME_PERIOD]),All_SDG_Goal12[Indicator]=indicator,All_SDG_Goal12[Geo]="EU_V",All_SDG_Goal12[unit]=unit)
				RETURN
				    SELECTCOLUMNS (
				        FILTER
				(All_SDG_Goal12,(All_SDG_Goal12[TIME_PERIOD]= maxTime_Period
				||
				All_SDG_Goal12[TIME_PERIOD]=maxTime_Period-5
				) && All_SDG_Goal12[Indicator]=indicator && All_SDG_Goal12[Unit]=unit),
				        "Year", All_SDG_Goal12[TIME_PERIOD],
				        "Value", All_SDG_Goal12[OBS_VALUE],
				        "Geo", All_SDG_Goal12[Geo]
				    ) 
				
				```

	annotation PBI_Id = 0875ac0785d3496d8f81c3e7794368f2

