table BW_Goal5_30
	lineageTag: 213c4b1b-9884-4a35-a9f8-17290deadcdc

	column Year
		formatString: 0
		lineageTag: 08f3fa0f-96b2-4d14-b741-fc1ac7c033c8
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

