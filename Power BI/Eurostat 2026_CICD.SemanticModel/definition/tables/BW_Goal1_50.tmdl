	column Sorting =
			
			var indicator = "SDG_01_50"
			var maxYear = CALCULATE(MAX(Goal1[Year]),Goal1[IndicatorValue]=indicator,Goal1[CountryAbrv]="EU27_2020")
			RETURN
			IF(BW_Goal1_50[Year]=maxYear,maxYear&BW_Goal1_50[Value],BLANK())
		dataType: double
		lineageTag: bdf8bb90-4c59-4821-bec0-03446e78c22a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition BW_Goal1_50 = calculated
		mode: import
		source =
				
				/* VAR indicator = "SDG_01_50"
				VAR maxYear = CALCULATE(MAX(Goal1[Year]), Goal1[IndicatorValue] = indicator, Goal1[CountryAbrv] = "EU27_2020", Goal1[Unit] = "PC")
				RETURN
				    SELECTCOLUMNS (
				        FILTER (
				            Goal1,
				            (Goal1[Year] = maxYear || Goal1[Year] = maxYear - 5) && Goal1[IndicatorValue] = indicator && Goal1[Unit] = "PC"
				        ),
				        "Year", Goal1[Year],
				        "Value", Goal1[Value],
				        "CountryAbrv", Goal1[CountryAbrv]
				    ) */
				        VAR indicator = "SDG_01_50"
				VAR maxYear = CALCULATE(MAX(All_SDG_Goal1[TIME_PERIOD]), All_SDG_Goal1[Indicator] = indicator, All_SDG_Goal1[Geo] = "EU27_2020", All_SDG_Goal1[Unit] = "PC")
				RETURN
				    SELECTCOLUMNS (
				        FILTER (
				            All_SDG_Goal1,
				            (All_SDG_Goal1[TIME_PERIOD] = maxYear || All_SDG_Goal1[TIME_PERIOD] = maxYear - 5) && All_SDG_Goal1[Indicator] = indicator && All_SDG_Goal1[Unit] = "PC" )
				        ,
				        "Year", All_SDG_Goal1[TIME_PERIOD],
				        "Value", All_SDG_Goal1[OBS_VALUE],
				        "CountryAbrv", All_SDG_Goal1[Geo]
				    )

	annotation PBI_Id = 7273bde8ce4a460e83ceb3951fd5fb15

