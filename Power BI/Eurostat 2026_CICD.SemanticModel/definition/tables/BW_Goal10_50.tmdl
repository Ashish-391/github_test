table BW_Goal10_50
	lineageTag: 14862c3e-54db-4016-9efe-39393b726d32

	column Year
		formatString: 0
		lineageTag: f1aeea2a-b9c5-4aa5-9b0f-5ed0e2ffc8d4
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

