	measure LT_value = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			VAR Max_Year = CALCULATE(MAX(Goal1[Year]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[CountryAbrv]=countrySelect)
			VAR Max_Year15_10 = CALCULATE(MAX(Goal1[Year]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[CountryAbrv]="EU27_2020")
			var min_year = CALCULATE(MIN(Goal1[Year]),ALLSELECTED(Goal1[UpdatedFromDate]))
			//var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			//var value = CALCULATE(MAX(Goal1[Value]
			var longtermCalc = 
			IF(indicator="SDG_15_50",Max_Year -16,
			IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 15 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-15,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 14 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-14,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 13 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-13,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 12 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-12,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 11 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-11,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year - 10 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]=countrySelect)) > 0,
			     Max_Year-10,BLANK()
			     )))))
			     
			     ))
			
			var longtermCalc_15_10 = 
			IF(indicator="SDG_15_50",Max_Year -16,
			IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year15_10 - 15 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]="EU27_2020")) > 0,
			     Max_Year15_10-15,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year15_10 - 14 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]="EU27_2020")) > 0,
			     Max_Year15_10-14,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year15_10 - 13 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]="EU27_2020")) > 0,
			     Max_Year15_10-13,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year15_10 - 12 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]="EU27_2020")) > 0,
			     Max_Year15_10-12,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year15_10 - 11 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]="EU27_2020")) > 0,
			     Max_Year15_10-11,
			     IF( COUNTROWS(FILTER(Goal1,Goal1[Year] = Max_Year15_10 - 10 && NOT ISBLANK(Goal1[Value])&& Goal1[CountryAbrv]="EU27_2020")) > 0,
			     Max_Year15_10-10,BLANK()
			     )))))
			     
			     ))
			
			
			RETURN
			
			if( indicator = "SDG_15_10",CALCULATE(MAX(Goal1[Value]),Goal1[Year]=longtermCalc_15_10,ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[CountryAbrv]="EU27_2020"),
			CALCULATE(MAX(Goal1[Value]),Goal1[Year]=longtermCalc,ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[CountryAbrv]=countrySelect))
			```
		lineageTag: 579c4248-477b-46a5-b98e-9aad36b4ef21

