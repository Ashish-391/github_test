table BW_Goal2_20
	lineageTag: 242f7455-01c1-4634-9c65-0a4e62d53a88

	column Sorting =
			
			IF(BW_Goal2_20[Year]=MAX(BW_Goal2_20[Year]),(MAX(BW_Goal2_20[Year])&BW_Goal2_20[Value]),BLANK())
		dataType: double
		lineageTag: e9bd76b8-d7f7-44fc-ac85-52467d0b5604
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Year
		formatString: 0
		lineageTag: 5fae9f35-85dd-473e-8d37-4c371d9d1f0a
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Value
		lineageTag: 403b9451-5b10-470c-b240-38a738852563
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

