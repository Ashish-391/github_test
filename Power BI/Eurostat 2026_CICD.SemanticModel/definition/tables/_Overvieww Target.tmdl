	measure A_shortbeg = ```
			
			 VAR MaxYearVal = [MaxxYear_Overview]
			 VAR ExcludedYear = 2020
			VAR MaxYearMinus4Val =
			    VAR y1 = MaxYearVal - 4
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			VAR MaxYearMinus5Val =
			    VAR y1 = MaxYearVal - 5
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			/* VAR MaxYearMinus4Val = MaxYearVal - 4 */
			var a = SELECTEDVALUE('_Overvieww Target'[Indicator])
			Return
			 SWITCH(TRUE(),
			a="SDG_04_40", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus4Val),
			a="SMG_04_40", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus4Val),
			a="SSG_04_40", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus4Val),  
			CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MAX(_Goal1_Overview[TIME_PERIOD])-5)
			  )
			```
