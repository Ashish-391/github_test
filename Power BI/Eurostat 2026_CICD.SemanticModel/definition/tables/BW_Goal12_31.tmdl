	column Sorting = IF(BW_Goal12_31[Year]=MAX(BW_Goal12_31[Year]),(MAX(BW_Goal12_31[Year])&BW_Goal12_31[Value]),BLANK())
		dataType: double
		lineageTag: 2953b686-b935-4478-a705-f602bd1ecebd
