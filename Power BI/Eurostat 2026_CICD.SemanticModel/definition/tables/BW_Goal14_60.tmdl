	column Sorting =
			
			var indicator = "SDG_14_60"
			var maxTime_Period = CALCULATE(MAX(All_SDG_Goal12[TIME_PERIOD]),All_SDG_Goal12[Indicator]=indicator)
			RETURN
			IF(BW_Goal14_60[Year]=maxTime_Period,maxTime_Period&BW_Goal14_60[Value],BLANK())
		dataType: double
		lineageTag: 8f10b0d0-97aa-4a09-bbda-4ca1731608ba
		summarizeBy: sum

