	measure Geo = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = IF(indicator="SDG_15_10" || indicator = "SDG_15_20" || indicator = "SDG_15_60","EU27_2020",
			CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")))
			RETURN
			SWITCH(SELECTEDVALUE('Datapoints-List'[Index]),
			                            /* 1,IF([CY]=BLANK(),"-",FORMAT([CY_value],"0")),
			                            2,IF([PY]=BLANK(),"-",FORMAT([PY_value],"0")),
			                           // 3,IF([TY]=BLANK(),"-",FORMAT([TY],"0")),
			                            4,IF([St]=BLANK(),"-",FORMAT([ST_Value],"0")),
			                            5,IF([LT]=BLANK(),"",FORMAT([LT_value],"0")),
			                            6,[YoY_Value],
			                            7,IF([ST]=BLANK(),"-",[ChangeShort_value]),
			                            8,[ChangeLongValue],
			                            17,[PeakValue],
			                            18,[LowValue],
			                            19,[ChangePeakValue],
			                            20,[ChangeLowValue],
			                            21,[Covid19ImpactValue],
			                            22,[CovidImpactValue],
			                            23,[CovidRecovery_Value],
			                             9,[CAGRShortTerm_Observed],
			                             12,[CAGRLongTerm_Observed], */
			                             24,[BestEU_Country],
			                             25,[BestEU_Country2],
			                            26,[BestEU_Country3],
			                            27,[WorstEU_Country],
			                            28,[WorstEU_Country2],
			                            29,[WorstEU_Country3],
			                            IF(country<>BLANK(),country,"EU27_2020")
			                           /* 10,[CAGRShortTermRequired],
			                            11,[CAGRShortRatio],
			                            
			                            13,[CAGRLongTermRequired],
			                            14,[CAGRLongRatio],
			                            
			                            
			                            23,[CovidRecoverLabel],
			                            ,
			                            
			                             */
			                        )
			```
		lineageTag: e5085cb9-5595-46d1-a30c-216e07bda925

	measure Units = ```
			
			var Unitt = IF(SELECTEDVALUE(Goal1[Unit])=BLANK(),"PC", SELECTEDVALUE(Goal1[Unit]))
			var BW_unit = IF(SELECTEDVALUE(eu_Goal1[Unit])=BLANK(),"PC", SELECTEDVALUE(eu_Goal1[Unit]))
			var Unit_LT = IF(CONTAINSSTRING(Unitt, "PC") || Unitt = "I10" || Unitt = "I00" || Unitt = "RT_INC" || Unitt = "I06" || Unitt = "PB" || Unitt = "RAT" || Unitt = "FSTK_BMA_I03" || unitt = "FSTK_MBMED" , "pp","%")
			var unit = [Unit 2]
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			RETURN
			SWITCH(SELECTEDVALUE('Datapoints-List'[Index]),
			//Category = Value 
			                            1,IF([CY_value]=BLANK(),"",Unitt),
			                            2,IF([PY_value]=BLANK(),"-",Unitt),
			                            3,IF([3TY]=BLANK(),"-",Unitt),
			                            4,IF([ST_Value]=BLANK(),"-",Unitt),
			                            5,IF([LT_value]=BLANK(),"",Unitt),
			                            17,IF(indicator="SDG_05_10","-",IF([PeakValue]=BLANK(),"-",Unitt)),
			                            18,IF(indicator="SDG_05_10","-",IF([LowValue]=BLANK(),"-",Unitt)),
			//Category = Change Since
			                            6,IF([PY_value]=BLANK(),"-",Unit_LT),
			                            7,IF(indicator="SDG_05_10","-",IF([ChangeShort_value]=BLANK(),"-",Unit_LT)),
			                            8,IF(ISBLANK([ChangeLongValue]),"-",Unit_LT),
			                            19,IF(ISBLANK([ChangePeakValue]),"-",Unit_LT),
			                            20,IF([ChangeLowValue]="" ,"-",Unit_LT),
			                            21,IF(ISBLANK([Covid19ImpactValue]),"-",Unit_LT),
			                            22,IF([CovidImpactValue]=BLANK(),"-",Unit_LT),
			                            23,IF([CovidRecovery_Value]=BLANK(),"-",Unit_LT),
			//Category = CAGR
			                             9,IF([CAGRShortTerm_Observed]=BLANK() || [ST_Value]=BLANK(),"-","% per year"),
			                             12,IF(ISBLANK([LT_value]),"-","% per year"),
			                             10,IF([CAGRShortTerm_Required]=BLANK(),"-","% per year"),
			                             11,IF([3TY]=BLANK() || [ST_Value]=BLANK(),"-","%"),
			                             13,IF([CAGRLongTerm_Required]=BLANK(),"-","% per year"),
			                             14,IF([3TY]=BLANK() || [CAGRRatio_LongTerm]=BLANK(),"-","%"),
			//Category = MS Comparison
			                             24,IF(ISBLANK([BestEU_Value]),"-",BW_unit),
			                             25,IF(ISBLANK([BestEU_Value2]),"-",BW_unit),
			                            26,IF(ISBLANK([BestEU_Value3]),"-",BW_unit),
			                            27,IF(ISBLANK([WorstEU_Value]),"-", IF([WorstEU_Value]=0,BW_unit, IF([WorstEU_Value]=BLANK(),"-",BW_unit))),
			                            28,IF(ISBLANK([WorstEU_Value]),"-",IF([WorstEU_Value2]=0,BW_unit, IF([WorstEU_Value2]=BLANK(),"-",BW_unit))),
			                            29,IF(ISBLANK([WorstEU_Value]),"-",IF([WorstEU_Value3]=0,BW_unit, IF([WorstEU_Value3]=BLANK(),"-",BW_unit)))
			                           /*
			                            23,[CovidRecoverLabel]
			                             */
			                        )
			```
		lineageTag: e2d2638e-1e38-45ea-862f-dec17cfb372c

	measure MaxxYear = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			RETURN
			CALCULATE(
			    MAX(Goal1[Year]),
			    ALLEXCEPT(Indicators,  Indicators[Indicator]),Goal1[CountryAbrv]=countrySelect,Goal1[UpdatedFromDate]=MAX(Goal1[UpdatedFromDate])
			)
			
			```
		formatString: 0
		lineageTag: fa34366b-9bae-496c-8746-034904c47217

	measure MaxYearMinus3or5_Overvieww = ```
			
			VAR MaxYearVal = [MaxxYear_Overview]
			/* VAR MaxYearMinus3Val = IF(( MaxYearVal - 3)=2020, MaxYearVal-4,MaxYearVal-3)
			VAR MaxYearMinus4Val = MaxYearVal - 4
			VAR MaxYearMinus5Val = MaxYearVal - 5
			Var MaxYearMinus6Val = MaxYearVal - 6 */
			VAR ExcludedYear = 2020
			
			VAR MaxYearMinus5Val =
			    VAR y1 = MaxYearVal - 5
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus4Val =
			    VAR y1 = MaxYearVal - 4
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus3Val =
			    VAR y1 = MaxYearVal - 3
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus6Val =
			    VAR y1 = MaxYearVal - 6
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			Var sd = BLANK()
			
			RETURN
			    IF( 
			        CALCULATE(MAX(_Goal1_Overview[Indicator]))="SDG_03_30",CALCULATE(MAX(_Goal1_Overview[TIME_PERIOD]), _Goal1_Overview[TIME_PERIOD] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(_Goal1_Overview[Indicator]))="SDG_15_50*",CALCULATE(MAX(_Goal1_Overview[TIME_PERIOD]), _Goal1_Overview[TIME_PERIOD] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(_Goal1_Overview[Indicator]))="SDG_15_50",CALCULATE(MAX(_Goal1_Overview[TIME_PERIOD]), _Goal1_Overview[TIME_PERIOD] = MaxYearMinus6Val),
			        IF( CALCULATE(MAX(_Goal1_Overview[Indicator]))="SDG_10_60",sd,
			        If(CALCULATE(COUNTROWS(FILTER(_Goal1_Overview, _Goal1_Overview[TIME_PERIOD] = MaxYearMinus5Val)), ALLEXCEPT(Indicators, Indicators[Indicator])) > 0,
			        CALCULATE(MAX(_Goal1_Overview[TIME_PERIOD]), _Goal1_Overview[TIME_PERIOD] = MaxYearMinus5Val),
			        If(CALCULATE(COUNTROWS(FILTER(_Goal1_Overview, _Goal1_Overview[TIME_PERIOD] = MaxYearMinus4Val)), ALLEXCEPT(Indicators, Indicators[Indicator])) > 0,
			        CALCULATE(MAX(_Goal1_Overview[TIME_PERIOD]), _Goal1_Overview[TIME_PERIOD] = MaxYearMinus4Val),
			         CALCULATE(MAX(_Goal1_Overview[TIME_PERIOD]), _Goal1_Overview[TIME_PERIOD] = MaxYearMinus3Val)
			    ))))))
			```
