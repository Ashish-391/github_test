	partition BW_Goal9_40 = calculated
		mode: import
		source =
				
				
				var indicator = "SDG_09_40"
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator,'All_SDG_Goal5-12'[Geo]="EU27_2020",'All_SDG_Goal5-12'[Coop_ptn]="APPL")
				
				RETURN
				
				    SELECTCOLUMNS (
				
				        FILTER
				
				('All_SDG_Goal5-12',('All_SDG_Goal5-12'[Time_Period]= maxTime_Period
				
				||
				
				'All_SDG_Goal5-12'[Time_Period]=maxTime_Period-5
				
				) && 'All_SDG_Goal5-12'[Indicator]=indicator && 'All_SDG_Goal5-12'[Coop_ptn]="APPL"),
				
				        "Year", 'All_SDG_Goal5-12'[Time_Period],
				
				        "Value", 'All_SDG_Goal5-12'[OBS_VALUE],
				
				        "Geo", 'All_SDG_Goal5-12'[Geo]
				
				    )

	annotation PBI_Id = 78ca6b4c109745f2bfed18bad0f98005

