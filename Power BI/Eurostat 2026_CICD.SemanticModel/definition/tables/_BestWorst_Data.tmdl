	measure BestEU_Country = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var dim = CALCULATE( MAX('Indicator Dimensions'[Dim]),'Indicator Dimensions'[Indicator]=indicator)
			var maxYear = [1CY]
			var maxBWYear_Value = CALCULATE(MAX(eu_Goal1[Value]),eu_Goal1[UpdatedFromDate]=ALLSELECTED(Goal1[UpdatedFromDate]),eu_Goal1[IndicatorValue]=indicator,eu_Goal1[Year]=maxYear)
			var maxBW_Year = IF(ISBLANK(maxBWYear_Value),CALCULATE(MAX(eu_Goal1[Year]),eu_Goal1[UpdatedFromDate]=ALLSELECTED(Goal1[UpdatedFromDate]),eu_Goal1[IndicatorValue]=indicator),[1CY])
			var minValue = CALCULATE(MIN(eu_Goal1[Value]),eu_Goal1[UpdatedFromDate]=ALLSELECTED(Goal1[UpdatedFromDate]),eu_Goal1[IndicatorValue]=indicator,eu_Goal1[Year]=maxBW_Year)
			var minValue2 = CALCULATE(MAX(eu_Goal1[Value]),eu_Goal1[UpdatedFromDate]=ALLSELECTED(Goal1[UpdatedFromDate]),eu_Goal1[IndicatorValue]=indicator,eu_Goal1[Year]=maxBW_Year)
			RETURN
			
			IF(dim = -1 ,
			CALCULATE(MIN(eu_Goal1[CountryAbrv]),eu_Goal1[Value]=minValue,eu_Goal1[UpdatedFromDate]=ALLSELECTED(Goal1[UpdatedFromDate]),eu_Goal1[IndicatorValue]=indicator,eu_Goal1[Year]=maxBW_Year), 
			CALCULATE(MAX(eu_Goal1[CountryAbrv]),eu_Goal1[Value]=minValue2,eu_Goal1[UpdatedFromDate]=ALLSELECTED(Goal1[UpdatedFromDate]),eu_Goal1[IndicatorValue]=indicator,eu_Goal1[Year]=maxBW_Year))
