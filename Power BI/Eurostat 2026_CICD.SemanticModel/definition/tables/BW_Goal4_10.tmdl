	partition BW_Goal4_10 = calculated
		mode: import
		source =
				
				var indicator = "sdg_04_10"
				//Var maxDate = CALCULATE(MAX('Goal 4 BW'[UpdatedFromDate]),'Goal 4 BW'[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal4'[Time_Period]),'All_SDG_Goal4'[Indicator]=indicator,'All_SDG_Goal4'[Geo]="EU27_2020")
				RETURN
				/*     SELECTCOLUMNS (
				        FILTER
				('All_SDG_Goal4',('All_SDG_Goal4'[Time_Period]= maxTime_Period
				||
				'All_SDG_Goal4'[Time_Period]=maxTime_Period-5
				) && 'All_SDG_Goal4'[Indicator]=indicator ),
				        "Year", All_SDG_Goal4[Time_Period],
				        "Value", All_SDG_Goal4[OBS_VALUE],
				        "CountryAbrv", All_SDG_Goal4[Geo]
				    ) */
				    FILTER
				('All_SDG_Goal4',('All_SDG_Goal4'[Time_Period]= maxTime_Period
				||
				'All_SDG_Goal4'[Time_Period]=maxTime_Period-5
				) && 'All_SDG_Goal4'[Indicator]=indicator )

	annotation PBI_Id = 7962fc0b9c73486981f3ee2cc24ffb54

