		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition BW_Goal8_20 = calculated
		mode: import
		source =
				
				var indicator = "SDG_08_20"
				
				//Var maxDate = CALCULATE(MAX('Goal 4 BW'[UpdatedFromDate]),'Goal 4 BW'[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator,'All_SDG_Goal5-12'[Geo]="EU27_2020",'All_SDG_Goal5-12'[Sex]="T")
				RETURN
				    SELECTCOLUMNS (
				        FILTER
				('All_SDG_Goal5-12',('All_SDG_Goal5-12'[Time_Period]= maxTime_Period
				||
				'All_SDG_Goal5-12'[Time_Period]=maxTime_Period-5
				) && 'All_SDG_Goal5-12'[Indicator]=indicator && 'All_SDG_Goal5-12'[Sex]="T"),
				        "Year", 'All_SDG_Goal5-12'[Time_Period],
				        "Value", 'All_SDG_Goal5-12'[OBS_VALUE],
				        "Geo", 'All_SDG_Goal5-12'[Geo]
				    )

	annotation PBI_Id = efe2dc5797cb43eb9ca2312dd22598a5

