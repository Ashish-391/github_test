	measure CovidRecoverLabel = ```
			
			var indicator = SELECTEDVALUE(Goal1[IndicatorValue])
			var country = CALCULATE( CALCULATE(MAX(Goal1[CountryAbrv]),Goal1[IndicatorValue]=indicator),CONTAINSSTRING(Goal1[CountryAbrv],"EU_V")) 
			var countrySelect = IF(country<>BLANK(),country,"EU27_2020")
			var covid20Value = CALCULATE(MAX(Goal1[Value]),ALLSELECTED(Goal1[UpdatedFromDate]),Goal1[IndicatorValue]=indicator,Goal1[Year]=2020,Goal1[CountryAbrv]=countrySelect)
			var maxYear= CALCULATE(MAX(Goal1[Year]),Goal1[CountryAbrv]=countrySelect,Goal1[IndicatorValue]=indicator)
			RETURN // || 2020<maxYear
			IF((indicator="SDG_04_70" || indicator="SDG_04_40" || indicator="SMG_04_40" || indicator="SSG_04_40") && covid20Value=BLANK(),"NA",
			IF((covid20Value=BLANK() && [1CY]=BLANK()) ||covid20Value=BLANK(),"NA","2020-"&CALCULATE(MAX(Goal1[Year]),Goal1[CountryAbrv]=countrySelect)))
			```
		lineageTag: 4d833db1-af96-45bc-ab77-f3366756004b

