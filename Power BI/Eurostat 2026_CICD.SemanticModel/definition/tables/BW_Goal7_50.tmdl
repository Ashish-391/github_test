	column Sorting = ```
			
			// var indicator = "SDG_07_50"
			// var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator)
			// RETURN
			// IF(BW_Goal7_50[Year]=maxTime_Period,ABS(maxTime_Period&BW_Goal7_50[Value]),BLANK())
			
			
			var indicator = "SDG_07_50"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]), 'All_SDG_Goal5-12'[Indicator] = indicator)
			RETURN
			IF(
			    BW_Goal7_50[Year] = maxTime_Period,
			    maxTime_Period + BW_Goal7_50[Value], -- Combine while keeping the result numeric
			    BLANK()
			)
			
			```
		dataType: double
		lineageTag: e05f2a16-4658-422c-8859-e517286b21bf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition BW_Goal7_50 = calculated
		mode: import
		source =
				
				var indicator = "SDG_07_50"
				var siec = "Total"
				//Var maxDate = CALCULATE(MAX('Goal 4 BW'[UpdatedFromDate]),'Goal 4 BW'[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator,'All_SDG_Goal5-12'[Geo]="EU27_2020",'All_SDG_Goal5-12'[siec]="Total")
				RETURN
				    SELECTCOLUMNS (
				        FILTER
				('All_SDG_Goal5-12',('All_SDG_Goal5-12'[Time_Period]= maxTime_Period
				||
				'All_SDG_Goal5-12'[Time_Period]=maxTime_Period-5
				) && 'All_SDG_Goal5-12'[Indicator]=indicator && 'All_SDG_Goal5-12'[siec]="Total"),
				        "Year", 'All_SDG_Goal5-12'[Time_Period],
				        "Value", 'All_SDG_Goal5-12'[OBS_VALUE],
				        "Geo", 'All_SDG_Goal5-12'[Geo]
				    )

	annotation PBI_Id = e79d997f8e744cfb9d86092bbbf45627

