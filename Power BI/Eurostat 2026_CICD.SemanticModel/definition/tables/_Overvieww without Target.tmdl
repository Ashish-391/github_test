	measure ShortTermBeginningValue_WT = ```
			
			/* var Max_Year1 = CALCULATE(MAX(Goal1_Overview[TIME_PERIOD])) 
			var min_year2 = CALCULATE(MIN(Goal1_Overview[TIME_PERIOD]))
			var longterm = Max_Year1 - min_year2 */
			var a = SELECTEDVALUE('_Goal1_Overview'[Indicator])
			VAR MaxYearVal = [MaxxYear_Overview]
			VAR ExcludedYear = 2020
			
			VAR MaxYearMinus5Val =
			    VAR y1 = MaxYearVal - 5
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus4Val =
			    VAR y1 = MaxYearVal - 4
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus3Val =
			    VAR y1 = MaxYearVal - 3
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			
			VAR MaxYearMinus6Val =
			    VAR y1 = MaxYearVal - 6
			    VAR y2 = IF(y1 = ExcludedYear, y1 - 1, y1)
			    RETURN y2
			VAR sd = BLANK()
			
			return 
			    IF(a="SDG_15_50*", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MAX(_Goal1_Overview[TIME_PERIOD])-6),
			        IF(a="SDG_03_30", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MAX(_Goal1_Overview[TIME_PERIOD])-6),
			            IF(a="SDG_04_40", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=/* MAX(Goal1_Overview[TIME_PERIOD])-4 */MaxYearMinus4Val),
			                IF(a="SMG_04_40", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus4Val),
			                    IF(a="SSG_04_40", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus4Val),
			                        IF(a="SDG_11_32*" || a="SDG_14_10", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus3Val),
			                        IF(a="SDG_12_51", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus4Val),
			                        IF(a="SDG_15_10", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus3Val),
			                        IF(a="SDG_15_50", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MAX(_Goal1_Overview[TIME_PERIOD])-6),
			                        IF(a="SDG_11_32", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus3Val),
			                      IF(a="SDG_10_60", sd,
			                        IF(a="SDG_17_60" || a="SDG_17_60*", CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus4Val),
			                        CALCULATE(MAX(_Goal1_Overview[OBS_VALUE]),_Goal1_Overview[TIME_PERIOD]=MaxYearMinus5Val)
			                    )
			                )
			            )
			        )
			    )
			)
			))))))
			```
		lineageTag: b80211f8-187e-4530-b37e-67ebb24c1fa1

