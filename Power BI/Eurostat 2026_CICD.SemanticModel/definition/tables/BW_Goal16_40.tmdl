table BW_Goal16_40
	lineageTag: f209588e-7687-4ce0-9d04-38de94c24f50

	column Year
		formatString: 0
		lineageTag: b12b3f9a-3356-48ab-a708-e8c26c7e74a8
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

