	partition BW_Goal5_11 = calculated
		mode: import
		source =
				
				var indicator = "sdg_05_11"
				//Var maxDate = CALCULATE(MAX('Goal 4 BW'[UpdatedFromDate]),'Goal 4 BW'[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator,'All_SDG_Goal5-12'[Geo]="EU_V")
				RETURN
				    SELECTCOLUMNS (
				        FILTER
				('All_SDG_Goal5-12',('All_SDG_Goal5-12'[Time_Period]= maxTime_Period
				||
				'All_SDG_Goal5-12'[Time_Period]=maxTime_Period-5
				) && 'All_SDG_Goal5-12'[Indicator]=indicator  && 'All_SDG_Goal5-12'[Age]="Y18-74"),
				        "Year", 'All_SDG_Goal5-12'[Time_Period],
				        "Value", 'All_SDG_Goal5-12'[OBS_VALUE],
				        "Geo", 'All_SDG_Goal5-12'[Geo]
				    )

	annotation PBI_Id = 0b686a89c14f447ea6799518dfd55055

