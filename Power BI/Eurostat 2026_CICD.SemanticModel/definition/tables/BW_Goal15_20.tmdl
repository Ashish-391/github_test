	column Geo
		lineageTag: 24187f2b-8b5e-439d-8886-5efc8080bc3a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Geo]

		annotation SummarizationSetBy = Automatic

	column Sorting =
			
			var indicator = "SDG_15_20"
			var maxTime_Period = CALCULATE(MAX(All_SDG_Goal15[TIME_PERIOD]),All_SDG_Goal15[Indicator]=indicator)
			RETURN
			IF(BW_Goal15_20[Year]=maxTime_Period,maxTime_Period&BW_Goal15_20[Value],BLANK())
		dataType: double
		lineageTag: 13a62fcf-2d55-48ed-82b5-1d1c44c78fc7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition BW_Goal15_20 = calculated
		mode: import
		source =
				
				
				var indicator = "SDG_15_20"
				var unit = "PC"
				var maxTime_Period = CALCULATE(MAX('All_SDG_Goal15'[Time_Period]),'All_SDG_Goal15'[Indicator]=indicator,'All_SDG_Goal15'[Geo]="EU27_2020",All_SDG_Goal15[Unit] = unit)
				
				RETURN
				
				    SELECTCOLUMNS (
				
				        FILTER
				
				('All_SDG_Goal15',('All_SDG_Goal15'[Time_Period]= maxTime_Period && All_SDG_Goal15[Unit] = unit
				
				/*||
				
				'All_SDG_Goal5-12'[Time_Period]=maxTime_Period-5
				*/
				) && 'All_SDG_Goal15'[Indicator]=indicator),
				
				        "Year", 'All_SDG_Goal15'[Time_Period],
				
				        "Value", 'All_SDG_Goal15'[OBS_VALUE],
				
				        "Geo", 'All_SDG_Goal15'[Geo]
				
				    )

	annotation PBI_Id = 22245534aa714a27871551b888048b6e

