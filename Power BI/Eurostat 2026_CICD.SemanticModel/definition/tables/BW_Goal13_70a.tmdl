	partition BW_Goal13_70a = calculated
		mode: import
		source = ```
				
				
				var indicator = "SDG_13_70a"
				//Var maxDate = CALCULATE(MAX('Goal 4 BW'[UpdatedFromDate]),'Goal 4 BW'[Indicator]=indicator)
				var maxTime_Period = CALCULATE(MAX(All_SDG_Goal12[TIME_PERIOD]),All_SDG_Goal12[Indicator]=indicator,All_SDG_Goal12[Geo]="EU27_2020")
				RETURN
				    SELECTCOLUMNS (
				        FILTER
				(All_SDG_Goal12,(All_SDG_Goal12[TIME_PERIOD]= maxTime_Period
				||
				All_SDG_Goal12[TIME_PERIOD]=maxTime_Period-5
				) && All_SDG_Goal12[Indicator]=indicator),
				        "Year", All_SDG_Goal12[TIME_PERIOD],
				        "Value", All_SDG_Goal12[OBS_VALUE],
				        "Geo", All_SDG_Goal12[Geo]
				    ) 
				
				```

