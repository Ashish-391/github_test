	column Sorting =
			
			var indicator = "SDG_13_11"
			var maxTime_Period = CALCULATE(MAX(All_SDG_Goal12[TIME_PERIOD]),'All_SDG_Goal12'[Indicator]=indicator)
			RETURN
			IF(BW_Goal13_11[Year]=maxTime_Period,maxTime_Period&BW_Goal13_11[Value],BLANK())
