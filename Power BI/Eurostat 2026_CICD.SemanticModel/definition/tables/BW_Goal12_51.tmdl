		isNameInferred
		sourceColumn: [Geo]

		annotation SummarizationSetBy = Automatic

	column Sorting = IF(BW_Goal12_51[Year]=MAX(BW_Goal12_51[Year]),(MAX(BW_Goal12_51[Year])&BW_Goal12_51[Value]),BLANK())
		dataType: double
		lineageTag: 48e3fad9-55ce-4c4c-80c7-fc5a0d602a6a
