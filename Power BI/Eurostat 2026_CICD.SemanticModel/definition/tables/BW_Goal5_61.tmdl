	column Sorting =
			
			var indicator = "SDG_05_61"
			var maxTime_Period = CALCULATE(MAX('All_SDG_Goal5-12'[Time_Period]),'All_SDG_Goal5-12'[Indicator]=indicator)
			RETURN
			IF(BW_Goal5_61[Year]=maxTime_Period,maxTime_Period&ABS(BW_Goal5_61[Value]),BLANK())
