table BW_Goal10_30
	lineageTag: d0dd1cec-943f-4ce1-a894-561e85764877

	column Year
		lineageTag: fd6ed084-0b1d-481c-8980-5c750181fe62
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

