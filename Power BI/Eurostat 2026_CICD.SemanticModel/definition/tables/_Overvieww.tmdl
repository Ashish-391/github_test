table _Overvieww
	lineageTag: b2358d2a-8390-4ba9-b4c2-4b4cc4b534f0

	measure Goal-Indicator-Title =
			var slicervalue = SELECTEDVALUE(SDG[Index],BLANK())
			return
			SWITCH(slicervalue,1,"Indicators measuring progress towards SDG 1, EU",
			                   2,"Indicators measuring progress towards SDG 2, EU",
			                   3,"Indicators measuring progress towards SDG 3, EU",
			                   4,"Indicators measuring progress towards SDG 4, EU",
			                   5,"Indicators measuring progress towards SDG 5, EU",
			                   6,"Indicators measuring progress towards SDG 6, EU",
			                   7,"Indicators measuring progress towards SDG 7, EU",
			                   8,"Indicators measuring progress towards SDG 8, EU",
			                   9,"Indicators measuring progress towards SDG 9, EU",
			                   10,"Indicators measuring progress towards SDG 10, EU",
			                   11,"Indicators measuring progress towards SDG 11, EU",
			                   12,"Indicators measuring progress towards SDG 12, EU",
			                   13,"Indicators measuring progress towards SDG 13, EU",
			                   14,"Indicators measuring progress towards SDG 14, EU",
			                   15,"Indicators measuring progress towards SDG 15, EU",
			                   16,"Indicators measuring progress towards SDG 16, EU",
			                   17,"Indicators measuring progress towards SDG 17, EU"
			                   )
			
			                  /*  3,"Under-Progress","Please select single or valid Goal value" */
		lineageTag: 651cf5a7-b07a-44be-b063-3780494ad851

	measure Long_Term_Year = ```
			var Max_Year = [MaxxYear_Overview]
			return
			IF( MAX(_Goal1_Overview[Indicator]) = "SDG_15_50*",
			     Max_Year-16,
			     IF( MAX(_Goal1_Overview[Indicator]) = "SDG_15_50",
			     Max_Year-16,
			IF( MAX(_Goal1_Overview[Indicator]) = "SDG_15_42",
			     Max_Year-14,
			IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 15 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-15,
			     IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 14 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-14,
			        IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 13 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-13,
			            IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 12 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-12,
			                IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 11 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-11,
			                    IF( COUNTROWS(FILTER(_Goal1_Overview,_Goal1_Overview[TIME_PERIOD] = Max_Year - 10 && NOT ISBLANK(_Goal1_Overview[OBS_VALUE]))) > 0,
			     Max_Year-10,
			     BLANK()
			                        )
			                    )
			                )
			            )
			        )
			     
			     ))))
			```
		formatString: 0
		lineageTag: 527ebe05-b1b1-445e-a4f9-da314c4d184a

