	measure 'Moving Avgg' = ```
			
			VAR indicator = "SDG_06_60"
			VAR currentIndicatorValue = SELECTEDVALUE(Goal1[IndicatorValue])
			VAR CURRENT_YEAR = CALCULATE(
			    MAX(Goal1[Year]),
			    ALLSELECTED(Goal1[UpdatedFromDate]),
			    Goal1[IndicatorValue] = indicator,
			    Goal1[CountryAbrv] = "EU27_2020"
			)
			VAR CurrentYear14_60 = CALCULATE(
			    MAX(Goal1[Year]),
			    ALLSELECTED(Goal1[UpdatedFromDate]),
			    Goal1[IndicatorValue] = "SDG_14_60",
			    Goal1[CountryAbrv] = "EU_V"
			)
			VAR CurrentYear15_42 = CALCULATE(
			    MAX(Goal1[Year]),
			    ALLSELECTED(Goal1[UpdatedFromDate]),
			    Goal1[IndicatorValue] = "SDG_15_42",
			    Goal1[CountryAbrv] = "EU27_2020"
			)
			RETURN 
			
			IF(
			    currentIndicatorValue = indicator,
			    AVERAGEX(
			        FILTER(
			            Goal1,
			            Goal1[Year] >= CURRENT_YEAR - 3 && Goal1[Year] <= CURRENT_YEAR &&
			            Goal1[IndicatorValue] = indicator &&
			            Goal1[CountryAbrv] = "EU27_2020"
			        ),
			        Goal1[Value]
			    ),
			if(currentIndicatorValue = "SDG_14_60",
			    AVERAGEX(
			        FILTER(
			            Goal1,
			            Goal1[Year] >= CurrentYear14_60 - 3 && Goal1[Year] <= CurrentYear14_60 &&
			            Goal1[IndicatorValue] = "SDG_14_60" &&
			            Goal1[CountryAbrv] = "EU_V"
			        ),
			        Goal1[Value]
			    ),
			if(currentIndicatorValue = "SDG_15_10",
			    AVERAGEX(
			        FILTER(
			            Goal1,
			            Goal1[Year] >= CURRENT_YEAR - 3 && Goal1[Year] <= CURRENT_YEAR &&
			            Goal1[IndicatorValue] = "SDG_15_10" &&
			            Goal1[CountryAbrv] = "EU27_2020"
			        ),
			        Goal1[Value]
			    ),
			if(currentIndicatorValue = "SDG_15_42",
			    AVERAGEX(
			        FILTER(
			            Goal1,
			            Goal1[Year] >= CurrentYear15_42 - 9 && Goal1[Year] <= CurrentYear15_42 &&
			            Goal1[IndicatorValue] = "SDG_15_42" &&
			            Goal1[CountryAbrv] = "EU27_2020"
			        ),
			        Goal1[Value]
			)))))
			```
