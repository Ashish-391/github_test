	column Sorting = IF(BW_Goal7_60[Year]=MAX(BW_Goal7_60[Year]),(MAX(BW_Goal7_60[Year])&BW_Goal7_60[Value]),BLANK())
		dataType: double
		lineageTag: ea98e0bd-89a8-4332-a03f-11906fb09cdc
